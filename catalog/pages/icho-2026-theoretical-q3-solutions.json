73950195312]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 304.7174987792969, 169.74588012695312, 318.28472900390625]}, {"text": "2 pt for each of COF-3 and COF-5. 1 pt for correct structure with wrong defined", "bbox": [114.69100189208984, 723.3934936523438, 480.5695495605469, 736.960693359375]}, {"text": "repeat unit.", "bbox": [114.69099426269531, 735.3485107421875, 168.99778747558594, 748.9157104492188]}, {"text": "4 pt for each of COF-4 and COF-6. 2 pt for correct structure with wrong defined", "bbox": [114.69100189208984, 747.3035278320312, 480.5695495605469, 760.8707275390625]}, {"text": "repeat unit.", "bbox": [114.69099426269531, 759.259521484375, 168.99778747558594, 772.8267211914062]}, {"text": "12.0 pt", "bbox": [495.1520080566406, 166.15451049804688, 526.921142578125, 179.72174072265625]}]}, {"page": 7, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-7", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "Macrocycle X was synthesised by post-synthetic modification of COF-7 (C2 + D4) followed by degradation.", "bbox": [56.69300079345703, 155.21949768066406, 538.58203125, 168.78672790527344]}, {"text": "3.5", "bbox": [78.60800170898438, 320.0245056152344, 92.84233856201172, 333.59173583984375]}, {"text": "Draw the smallest repeat unit of macrocycle X.", "bbox": [114.69253540039062, 320.0245056152344, 333.7086181640625, 333.59173583984375]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 331.9794921875, 169.74588012695312, 345.5467224121094]}, {"text": "6 pt for repeat unit X.", "bbox": [114.69100189208984, 440.635498046875, 214.9886474609375, 454.2027282714844]}, {"text": "-2 pt for imine product.", "bbox": [114.69100952148438, 452.5904846191406, 222.9851531982422, 466.15771484375]}, {"text": "-2 pt if aldehyde is not shown.", "bbox": [114.69100952148438, 464.54547119140625, 254.37728881835938, 478.1127014160156]}, {"text": "-2 pt if fluorines are missing.", "bbox": [114.69100952148438, 476.5004577636719, 247.851806640625, 490.06768798828125]}, {"text": "6.0 pt", "bbox": [495.45001220703125, 319.948486328125, 521.8194580078125, 333.5157165527344]}]}, {"page": 8, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-8", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "π-π interactions result in different stacking modes of COF layers, some of which are shown below.", "bbox": [56.69300079345703, 130.40113830566406, 514.740234375, 196.35354614257812]}, {"text": "Depending on stacking geometry, the interaction energy can be different as shown below.", "bbox": [56.69300079345703, 306.62548828125, 477.9223327636719, 320.1927185058594]}, {"text": "𝐸/ kJ mol−1", "bbox": [372.2040100097656, 325.0992126464844, 427.6797790527344, 361.1191101074219]}, {"text": "Interaction geometry", "bbox": [163.21701049804688, 365.4744873046875, 262.7908630371094, 379.0417175292969]}, {"text": "benzene (X = CH) – benzene (b-b)", "bbox": [136.4499969482422, 408.114501953125, 289.5433349609375, 421.6817321777344]}, {"text": "−7.9", "bbox": [347.9939880371094, 408.114501953125, 367.757568359375, 421.6817321777344]}, {"text": "−12.6", "bbox": [429.7799987792969, 408.114501953125, 455.2421875, 421.6817321777344]}, {"text": "benzene-triazine (X = N) (b-t)", "bbox": [146.7919921875, 424.05450439453125, 279.2229309082031, 437.6217346191406]}, {"text": "−49.8", "bbox": [345.14599609375, 424.05450439453125, 370.6081848144531, 437.6217346191406]}, {"text": "−55.6", "bbox": [429.7799987792969, 424.05450439453125, 455.2421875, 437.6217346191406]}, {"text": "triazine–triazine (t-t)", "bbox": [166.13600158691406, 439.9955139160156, 259.8721618652344, 453.562744140625]}, {"text": "−6.7", "bbox": [347.9939880371094, 439.9955139160156, 367.757568359375, 453.562744140625]}, {"text": "−16.7", "bbox": [429.7799987792969, 439.9955139160156, 455.2421875, 453.562744140625]}, {"text": "COF-8, synthesised from (E1 + D2), is notable for its remarkable stability. The AA' slightly shifted mode of", "bbox": [56.69300079345703, 473.8265075683594, 538.5752563476562, 487.39373779296875]}, {"text": "a COF-8 bilayer has a π-π stacking interaction energy of –67.1 kJ mol−1 between two layers of one repeat", "bbox": [56.693023681640625, 462.44415283203125, 538.5778198242188, 528.3965454101562]}, {"text": "unit.", "bbox": [56.693023681640625, 499.2174987792969, 77.84428405761719, 512.7847290039062]}]}, {"page": 9, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-9", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "3.6", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Calculate the π-π stacking energy between two layers of one repeat unit of", "bbox": [114.69253540039062, 166.2294921875, 480.5688171386719, 179.79672241210938]}, {"text": "COF-8, for the AA, AB and AB' arrangements. Assume π-π stacking happens", "bbox": [114.69100189208984, 178.18450927734375, 480.56341552734375, 191.75173950195312]}, {"text": "only between aromatic units.", "bbox": [114.69097900390625, 190.1405029296875, 250.26271057128906, 203.70773315429688]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 202.0955047607422, 169.74588012695312, 215.66273498535156]}, {"text": "COF-8 represents hexagonal 2 topology. Each repeat unit contain 4 benzene", "bbox": [114.69100189208984, 214.05050659179688, 480.5650939941406, 227.61773681640625]}, {"text": "and 1 triazine rings. For AA and AA’ stacking modes there will be 4 b-b and 1", "bbox": [114.69100189208984, 226.00550842285156, 480.5741271972656, 239.57273864746094]}, {"text": "t-t interactions. For AB each repeat unit will have 1 b-t interactions as shown", "bbox": [114.69099426269531, 237.96051025390625, 480.5990905761719, 251.52774047851562]}, {"text": "below for AB’ arrangement (hexagons is redrawn to show all interactions).", "bbox": [114.69100189208984, 249.91552734375, 461.31695556640625, 263.4827575683594]}, {"text": "Thus, calculations will be as follows:", "bbox": [114.69100189208984, 450.4574890136719, 281.5453186035156, 464.02471923828125]}, {"text": "Interaction number", "bbox": [173.1719970703125, 494.8374938964844, 264.7391357421875, 508.40472412109375]}, {"text": "Interaction energy, kJ mol−1", "bbox": [299.4580078125, 470.0191345214844, 431.63018798828125, 535.9715576171875]}, {"text": "Total energy, kJ mol−1", "bbox": [445.38800048828125, 476.1181335449219, 549.0542602539062, 542.070556640625]}, {"text": "b-b", "bbox": [162.27999877929688, 516.3565063476562, 177.74429321289062, 529.9237060546875]}, {"text": "b-t", "bbox": [212.4929962158203, 516.3565063476562, 225.42286682128906, 529.9237060546875]}, {"text": "t-t", "bbox": [262.70501708984375, 516.3565063476562, 273.1043701171875, 529.9237060546875]}, {"text": "b-b", "bbox": [309.1159973144531, 516.3565063476562, 324.5802917480469, 529.9237060546875]}, {"text": "b-t", "bbox": [359.3280029296875, 516.3565063476562, 372.25787353515625, 529.9237060546875]}, {"text": "t-t", "bbox": [409.5409851074219, 516.3565063476562, 419.9403381347656, 529.9237060546875]}, {"text": "AA", "bbox": [123.34100341796875, 532.2965087890625, 137.0888061