[{"page": 1, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-1", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "T4. The nuclear past of Uzbekistan", "bbox": [56.69300079345703, 151.06434631347656, 330.6927185058594, 172.77197265625]}, {"text": "6%", "bbox": [290.6499938964844, 193.70750427246094, 304.6280822753906, 207.2747344970703]}, {"text": "4.1", "bbox": [141.0570068359375, 209.6475067138672, 155.12197875976562, 223.21473693847656]}, {"text": "4.2", "bbox": [172.68299865722656, 209.6475067138672, 186.7479705810547, 223.21473693847656]}, {"text": "4.3", "bbox": [204.3090057373047, 209.6475067138672, 218.37399291992188, 223.21473693847656]}, {"text": "4.4", "bbox": [235.93499755859375, 209.6475067138672, 249.99998474121094, 223.21473693847656]}, {"text": "4.5", "bbox": [267.5610046386719, 209.6475067138672, 281.6259765625, 223.21473693847656]}, {"text": "4.6", "bbox": [299.18701171875, 209.6475067138672, 313.2519836425781, 223.21473693847656]}, {"text": "4.7", "bbox": [330.81298828125, 209.6475067138672, 344.8779602050781, 223.21473693847656]}, {"text": "4.8", "bbox": [362.4389953613281, 209.6475067138672, 376.50396728515625, 223.21473693847656]}, {"text": "4.9", "bbox": [394.06500244140625, 209.6475067138672, 408.1299743652344, 223.21473693847656]}, {"text": "∑", "bbox": [436.81201171875, 209.6475067138672, 443.0970153808594, 223.21473693847656]}, {"text": "2", "bbox": [145.24099731445312, 225.5885009765625, 150.93739318847656, 239.15573120117188]}, {"text": "3", "bbox": [176.86700439453125, 225.5885009765625, 182.5634002685547, 239.15573120117188]}, {"text": "3", "bbox": [208.4929962158203, 225.5885009765625, 214.18939208984375, 239.15573120117188]}, {"text": "2", "bbox": [240.11900329589844, 225.5885009765625, 245.81539916992188, 239.15573120117188]}, {"text": "2", "bbox": [271.7449951171875, 225.5885009765625, 277.4413757324219, 239.15573120117188]}, {"text": "2", "bbox": [303.3710021972656, 225.5885009765625, 309.0673828125, 239.15573120117188]}, {"text": "2", "bbox": [334.99700927734375, 225.5885009765625, 340.6933898925781, 239.15573120117188]}, {"text": "2", "bbox": [366.62298583984375, 225.5885009765625, 372.3193664550781, 239.15573120117188]}, {"text": "4", "bbox": [398.2489929199219, 225.5885009765625, 403.94537353515625, 239.15573120117188]}, {"text": "22", "bbox": [434.25799560546875, 225.5885009765625, 445.6529846191406, 239.15573120117188]}, {"text": "Natural uranium consists primarily of two isotopes, 235U and 238U", "bbox": [56.69300079345703, 245.60623168945312, 374.0386047363281, 280.7225646972656]}, {"text": ". 235U is responsible for sustaining", "bbox": [371.4606018066406, 245.60623168945312, 538.576416015625, 280.7225646972656]}, {"text": "nuclear fission reactions.", "bbox": [56.6929931640625, 273.905517578125, 172.9571990966797, 287.4727478027344]}, {"text": "4.1", "bbox": [78.60799407958984, 299.4024963378906, 92.84233093261719, 312.9697265625]}, {"text": "Calculate the atomic abundance of 235U in natural uranium, assuming it con-", "bbox": [114.69253540039062, 283.0581970214844, 480.5711669921875, 318.174560546875]}, {"text": "sists only of isotopes 235U (235.04 a.u.) and 238U (238.05 a.u.).", "bbox": [114.69100952148438, 297.5932312011719, 402.1573181152344, 332.7095642089844]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 325.8924865722656, 169.74588012695312, 339.459716796875]}, {"text": "Using the average atomic mass of uranium from the Periodic Table as 238.03", "bbox": [114.69100189208984, 337.8484802246094, 480.5752258300781, 351.41571044921875]}, {"text": "a.u., and isotope masses as 235.04 a.u. for 235U and 238.05 a.u. for 238U, we", "bbox": [114.69100189208984, 326.5731201171875, 480.57391357421875, 392.5255432128906]}, {"text": "can calculate the atomic abundance, 𝑥, of 235U.", "bbox": [114.69097900390625, 340.11712646484375, 334.5185852050781, 406.0695495605469]}, {"text": "Equation:", "bbox": [114.69096374511719, 388.8464660644531, 159.12481689453125, 402.4136962890625]}, {"text": "238.03 = 𝑥× 235.04 + (1 −𝑥) × 238.05", "bbox": [114.69096374511719, 385.88092041015625, 275.9288635253906, 420.47607421875]}, {"text": "(1)", "bbox": [295.85406494140625, 385.88592529296875, 308.1885070800781, 420.47607421875]}, {"text": "238.03 = 235.04𝑥+ 238.05 −238.05𝑥", "bbox": [114.69097900390625, 397.8409118652344, 270.0975036621094, 432.4310607910156]}, {"text": "238.03 −238.05 = 𝑥(235.04 −238.05)", "bbox": [114.69097900390625, 409.7908935546875, 272.9205017089844, 444.38604736328125]}, {"text": "−0.02 = 𝑥(−3.01)", "bbox": [114.69096374511719, 421.7458801269531, 191.5585174560547, 456.3410339355469]}, {"text": "𝑥= −0.02", "bbox": [114.69096374511719, 433.1231384277344, 160.7351531982422, 469.9400329589844]}, {"text": "−3.01 = 0.00664 = 0.66%", "bbox": [138.90200805664062, 435.3499755859375, 246.4909210205078, 474.7221374511719]}, {"text": "The atomic abundance of 235U in natural uranium is approximately 0.66%,", "bbox": [114.69099426269531, 449.35711669921875, 480.5798645019531, 515.3095092773438]}, {"text": "which is a slightly lower estimate compared to the commonly accepted value", "bbox": [114.69099426269531, 486.1304626464844, 480.5870666503906, 499.69769287109375]}, {"text": "of about 0.72%, influenced by rounding and exact values used.", "bbox": [114.69099426269531, 498.08544921875, 407.0242614746094, 511.6526794433594]}, {"text": "The atomic abundance of 235U is 0.66%", "bbox": [114.69099426269531, 486.81109619140625, 294.8215637207031, 552.7634887695312]}, {"text": "2 points total: 1 point for equation (1);", "bbox": [114.69100189208984, 523.5855102539062, 293.3736267089844, 537.1527099609375]}, {"text": "1 point for the correct answer.", "bbox": [114.69100952148438, 535.5404663085938, 256.4395446777344, 549.107666015625]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 299.3265075683594, 521.8194580078125, 312.89373779296875]}, {"text": "The main reaction occurring in nuclear power plants is the reaction where 235U absorbs a neutron and", "bbox": [56.69300079345703, 548.88623046875, 538.56884765625, 584.0035400390625]}, {"text": "undergoes fission, releasing energy and producing three additional neutrons, thus sustaining a chain", "bbox": [56.692962646484375, 577.1865234375, 538.5458374023438, 590.7537231445312]}, {"text": "reaction.", "bbox": [56.692962646484375, 589.1415405273438, 97.72957611083984, 602.708740234375]}, {"text": "235", "bbox": [249.4199676513672, 602.6842041015625, 262.86956787109375, 633.8155517578125]}, {"text": "92 U +1", "bbox": [249.4199676513672, 602.6842041015625, 284.17218017578125, 642.632568359375]}, {"text": "0 n →… + 31", "bbox": [279.68896484375, 602.6842041015625, 339.19818115234375, 642.507568359375]}, {"text": "0n", "bbox": [334.7149963378906, 611.376220703125, 345.8554992675781, 642.507568359375]}, {"text": "Neutrons that induce the chain reaction are produced by several ways:", "bbox": [56.6929931640625, 644.5785522460938, 386.23651123046875, 658.145751953125]}, {"text": "a) Reaction of 11B with 𝛼-particles inside the reactor core", "bbox": [56.6929931640625, 647.6483154296875, 320.5979919433594, 683.6671752929688]}, {"text": "b) Interaction of 𝛾rays with 2D nuclei present in the reactor coolant water", "bbox": [56.69300079345703, 667.062255859375, 400.4232177734375, 703.0811767578125]}, {"text": "c) Reaction of 9Be with 𝛼-particles produced in an externally installed neutron source.", "bbox": [56.69300079345703, 686.4752197265625, 454.2066955566406, 722.4951782226562]}]}, {"page": 2, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-2", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "4.2", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Write the nuclear reaction equations for (a), (b), and (c).", "bbox": [114.69253540039062, 166.2294921875, 377.839599609375, 179.79672241210938]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 178.18450927734375, 169.74588012695312, 191.75173950195312]}, {"text": "Reaction (a): 11", "bbox": [114.69100189208984, 173.79522705078125, 184.46640014648438, 208.91256713867188]}, {"text": "5 B + 4", "bbox": [175.5, 173.79522705078125, 207.17520141601562, 213.72557067871094]}, {"text": "2𝛼→14", "bbox": [202.69200134277344, 173.79522705078125, 237.0194091796875, 213.61756896972656]}, {"text": "7 N + 1", "bbox": [228.05300903320312, 173.79522705078125, 260.82220458984375, 213.49256896972656]}, {"text": "0n", "bbox": [256.3389892578125, 182.48622131347656, 267.478515625, 213.61756896972656]}, {"text": "Reaction (b): 𝛾+ 2", "bbox": [114.69100952148438, 189.7772216796875, 196.8372039794922, 225.797119140625]}, {"text": "1D →1", "bbox": [192.35299682617188, 189.7772216796875, 223.8511962890625, 229.60057067871094]}, {"text": "1H + 1", "bbox": [219.3679962158203, 189.7772216796875, 247.4691925048828, 229.60057067871094]}, {"text": "0n", "bbox": [242.98599243164062, 198.46922302246094, 254.1265106201172, 229.60057067871094]}, {"text": "Reaction (c): 9", "bbox": [114.69099426269531, 205.6522216796875, 179.17518615722656, 240.76856994628906]}, {"text": "4Be + 4", "bbox": [174.69198608398438, 205.6522216796875, 207.50318908691406, 245.67156982421875]}, {"text": "2𝛼→12", "bbox": [203.01998901367188, 205.6522216796875, 237.34739685058594, 245.4745635986328]}, {"text": "6 C + 1", "bbox": [228.38099670410156, 205.6522216796875, 259.87518310546875, 245.54656982421875]}, {"text": "0n", "bbox": [255.39199829101562, 214.3432159423828, 266.5325012207031, 245.4745635986328]}, {"text": "3 points total: 1 point for each full and correct equation.", "bbox": [114.69099426269531, 235.5185089111328, 376.36932373046875, 249.0857391357422]}, {"text": "3.0 pt", "bbox": [495.45001220703125, 166.15451049804688, 521.8194580078125, 179.72174072265625]}, {"text": "The graph above displays the percentage yield, P(A), of fission products by mass number, A, resulting", "bbox": [56.69300079345703, 604.3544921875, 538.5911865234375, 617.9216918945312]}, {"text": "from 235U fission.", "bbox": [56.6929931640625, 601.55419921875, 138.848876953125, 636.6705322265625]}]}, {"page": 3, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-3", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "4.3", "bbox": [78.60800170898438, 168.76150512695312, 92.84233856201172, 182.3287353515625]}, {"text": "Write the main nuclear fission equation for splitting of 235U upon neutron ab-", "bbox": [114.69253540039062, 152.41622924804688, 480.56903076171875, 187.5335693359375]}, {"text": "sorption. The pair of elements formed in this reaction are in the same group of", "bbox": [114.69100952148438, 180.7165069580078, 480.5599365234375, 194.2837371826172]}, {"text": "Periodic Table.", "bbox": [114.69100952148438, 192.6715087890625, 182.8458251953125, 206.23873901367188]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 204.62649536132812, 169.74588012695312, 218.1937255859375]}, {"text": "Let us presume that total atomic mass of elements in the fission products is", "bbox": [114.69100189208984, 216.5814971923828, 480.5775146484375, 230.1487274169922]}, {"text": "∑𝐴= 235+1−3 = 233 There are two maxima on the graph at 𝐴= 93 and 𝐴= 140,", "bbox": [114.69100189208984, 213.62197875976562, 480.5845947265625, 248.23110961914062]}, {"text": "which sum up to 233. Thus, there are only two fission products beside neutrons", "bbox": [114.69097900390625, 240.4925079345703, 480.5775146484375, 254.0597381591797]}, {"text": "considered in the question. To find the atomic numbers we use conservation of", "bbox": [114.69097900390625, 252.447509765625, 480.55999755859375, 266.0147399902344]}, {"text": "charge and come to equation: 𝑥+𝑦= 92 with 𝑥and 𝑦denoting atomic numbers", "bbox": [114.69097900390625, 249.48699951171875, 480.5674743652344, 284.0771484375]}, {"text": "of elements. These elements are in the same group, the intervals between them", "bbox": [114.69097900390625, 276.3575134277344, 480.5680847167969, 289.92474365234375]}, {"text": "may be 2, 8, 18, 32, and 50. Let’s solve the equation for those parameters:", "bbox": [114.69097900390625, 288.3125, 480.59796142578125, 301.8797302246094]}, {"text": "𝑥+ (𝑥+ 𝑎) = 92 where 𝑎= 2, 8, 18, 32, 50", "bbox": [114.69097900390625, 275.45013427734375, 292.7498474121094, 341.4025573730469]}, {"text": "𝑥= 45, 𝑦= 47 (𝑅ℎ, 𝐴𝑔, 𝑎= 2)", "bbox": [114.69097900390625, 297.302978515625, 243.58853149414062, 331.89813232421875]}, {"text": "𝑥= 42, 𝑦= 50 (𝑀𝑜, 𝑆𝑛, 𝑎= 8)", "bbox": [114.69097900390625, 309.2579650878906, 245.6205291748047, 343.8531188964844]}, {"text": "𝑥= 37, 𝑦= 55 (𝑅𝑏, 𝐶𝑠, 𝑎= 18)", "bbox": [114.69097900390625, 321.21295166015625, 244.33753967285156, 355.80810546875]}, {"text": "𝑥= 30, 𝑦= 62 (𝑍𝑛, 𝑆𝑚, 𝑎= 32)", "bbox": [114.69098663330078, 333.1679382324219, 248.00453186035156, 367.7630920410156]}, {"text": "𝑥= 21, 𝑦= 71 (𝑆𝑐, 𝐿𝑢, 𝑎= 50)", "bbox": [114.69097900390625, 345.1229248046875, 243.99952697753906, 379.71807861328125]}, {"text": "Technically, Sc-Lu pair might do it, but there is no evidence for such high mass", "bbox": [114.69097900390625, 371.99945068359375, 480.56756591796875, 385.5666809082031]}, {"text": "number isotope of scandium (𝐴= 93), so the only reasonable answer is Rb and", "bbox": [114.69097900390625, 369.0389099121094, 480.5716857910156, 403.6290588378906]}, {"text": "Cs.", "bbox": [114.69097900390625, 395.909423828125, 128.43006896972656, 409.4766540527344]}, {"text": "Equation of nuclear fission reaction: 235", "bbox": [114.69097900390625, 391.3951416015625, 299.48260498046875, 426.636474609375]}, {"text": "92 U + 1", "bbox": [286.032958984375, 391.5201721191406, 322.9981689453125, 431.3424987792969]}, {"text": "0n →93", "bbox": [318.51495361328125, 391.32318115234375, 353.38238525390625, 431.342529296875]}, {"text": "37Rb + 140", "bbox": [344.4159851074219, 391.39520263671875, 390.90960693359375, 431.342529296875]}, {"text": "55 Cs + 31", "bbox": [377.4599609375, 391.5202331542969, 423.191162109375, 431.4505615234375]}, {"text": "0n", "bbox": [418.70794677734375, 400.21124267578125, 429.84844970703125, 431.34259033203125]}, {"text": "3 points total:", "bbox": [114.69094848632812, 421.3695373535156, 178.86073303222656, 434.936767578125]}, {"text": "0.6 point for each correct atomic mass of two elements (1.2 points). If the stu-", "bbox": [114.69094848632812, 433.32452392578125, 480.5850830078125, 446.8917541503906]}, {"text": "dent provides the sum of the atomic masses of two elements they will also be", "bbox": [114.69094848632812, 445.2795104980469, 480.5769958496094, 458.84674072265625]}, {"text": "given 1.2 points.", "bbox": [114.69094848632812, 457.2355041503906, 191.3837127685547, 470.802734375]}, {"text": "0.6 point for each correct element (1.2 points).", "bbox": [114.69094848632812, 469.19049072265625, 330.4616394042969, 482.7577209472656]}, {"text": "0.6 point for nuclear fission reaction equation.", "bbox": [114.69094848632812, 481.1454772949219, 330.4815368652344, 494.71270751953125]}, {"text": "3.0 pt", "bbox": [495.45001220703125, 168.6855010986328, 521.8194580078125, 182.2527313232422]}, {"text": "4.4", "bbox": [78.60800170898438, 515.8684692382812, 92.84233856201172, 529.4356689453125]}, {"text": "Calculate the energy released in this reaction (ΔE, MeV), if the binding energy", "bbox": [114.69253540039062, 515.8684692382812, 480.5744934082031, 529.4356689453125]}, {"text": "𝐵𝐸(235U) = 7.59 MeV/nucleon and average binding energy for fission products", "bbox": [114.69100952148438, 514.0592041015625, 480.56597900390625, 550.0791015625]}, {"text": "𝐵𝐸(fis.) = 8.45 MeV/nucleon. Neglect the binding energy of free neutrons.", "bbox": [114.69100952148438, 517.5411376953125, 458.55596923828125, 583.4935302734375]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 554.3145141601562, 169.74588012695312, 567.8817138671875]}, {"text": "Δ𝐸= 8.45 × 233 −7.59 × 235 = 185.20 MeV", "bbox": [114.69100189208984, 541.4511108398438, 306.03106689453125, 607.4035034179688]}, {"text": "Released energy: 185.2 MeV", "bbox": [114.69099426269531, 578.2244873046875, 246.86578369140625, 591.7916870117188]}, {"text": "2 points for the correct answer and relevant calculations; 1 point may be given", "bbox": [114.69099426269531, 590.1804809570312, 480.57904052734375, 603.7476806640625]}, {"text": "for the right formula but the wrong answer.", "bbox": [114.69099426269531, 602.135498046875, 319.6721496582031, 615.7026977539062]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 515.7935180664062, 521.8194580078125, 529.3607177734375]}, {"text": "Fission neutrons are produced with an average energy of 2 MeV and slow down through many scatterings", "bbox": [56.69300079345703, 631.8264770507812, 538.5442504882812, 645.3936767578125]}, {"text": "with nuclei. After several collisions, their speed decreases until their average kinetic energy matches that", "bbox": [56.69300079345703, 643.781494140625, 538.5823364257812, 657.3486938476562]}, {"text": "of the surrounding atoms or molecules.", "bbox": [56.69300079345703, 655.7365112304688, 242.3865966796875, 669.3037109375]}, {"text": "The logarithmic energy decrement, 𝜉, shows the average decrease per collision in the logarithm of", "bbox": [56.69300079345703, 658.7539672851562, 538.5692138671875, 693.3441162109375]}, {"text": "the neutron energy:", "bbox": [56.6929931640625, 685.62451171875, 150.3122100830078, 699.1917114257812]}, {"text": "𝜉= ln (", "bbox": [259.22698974609375, 707.4459838867188, 294.83575439453125, 749.7921142578125]}, {"text": "𝐸𝑖𝑛𝑖𝑡𝑖𝑎𝑙", "bbox": [296.031982421875, 700.06494140625, 326.1258544921875, 736.2435302734375]}, {"text": "𝐸𝑓𝑖𝑛𝑎𝑙)", "bbox": [297.197021484375, 714.4209594726562, 336.0487976074219, 750.5995483398438]}, {"text": "𝐸𝑖𝑛𝑖𝑡𝑖𝑎𝑙and 𝐸𝑓𝑖𝑛𝑎𝑙are the initial and final neutron energies per collision.", "bbox": [56.69300842285156, 740.8469848632812, 391.50830078125, 777.0255737304688]}, {"text": "𝜉is a constant for each type of material and does not depend on the initial neutron energy.", "bbox": [56.69300842285156, 758.7799682617188, 481.7059326171875, 793.3701171875]}]}, {"page": 4, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-4", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "4.5", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Determine the average number of collisions required, n𝑐, to slow a neutron", "bbox": [114.69253540039062, 156.3612060546875, 480.5860290527344, 187.4925537109375]}, {"text": "from 2 MeV to 0.012 eV, using water as the moderator. 𝜉(water)=0.948", "bbox": [114.69100952148438, 163.26898193359375, 444.91192626953125, 197.859130859375]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 190.1405029296875, 169.74588012695312, 203.70773315429688]}, {"text": "𝑛𝑐=", "bbox": [114.69100189208984, 201.8