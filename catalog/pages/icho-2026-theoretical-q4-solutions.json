, {"text": "Balanced", "bbox": [114.69100189208984, 360.3244934082031, 157.60226440429688, 373.8917236328125]}, {"text": "reaction:", "bbox": [170.32215881347656, 360.3244934082031, 211.35877990722656, 373.8917236328125]}, {"text": "CH4(𝑔)", "bbox": [235.07199096679688, 335.5061340332031, 266.6432189941406, 401.45855712890625]}, {"text": "+", "bbox": [277.5323486328125, 345.4089660644531, 284.3567199707031, 379.9991149902344]}, {"text": "2O2(𝑔)", "bbox": [295.245849609375, 335.5061340332031, 324.8861999511719, 401.45855712890625]}, {"text": "→", "bbox": [349.3344421386719, 345.4089660644531, 358.559814453125, 379.9991149902344]}, {"text": "CO2(𝑔)", "bbox": [383.00897216796875, 335.5061340332031, 414.8601989746094, 401.45855712890625]}, {"text": "+", "bbox": [425.74932861328125, 345.4089660644531, 432.5736999511719, 379.9991149902344]}, {"text": "2H2O(𝑔)", "bbox": [443.46282958984375, 335.5061340332031, 480.58416748046875, 401.45855712890625]}, {"text": "Δ𝑟𝐻∘", "bbox": [114.69097900390625, 355.9352111816406, 138.77322387695312, 393.54254150390625]}, {"text": "298 = [Δ𝑓𝐻∘(CO2) + 2Δ𝑓𝐻∘(H2O)] −[Δ𝑓𝐻∘(CH4) + 2Δ𝑓𝐻∘(O2)]", "bbox": [134.73797607421875, 347.4611511230469, 424.97998046875, 413.41357421875]}, {"text": "Δ𝑟𝐻∘", "bbox": [114.69091796875, 371.8812255859375, 138.77316284179688, 409.4885559082031]}, {"text": "298 = ([−393.5 + 2(−241.8)] −[−74.8 + 0])kJ mol−1 = −802.3 kJ mol−1", "bbox": [134.7379150390625, 363.40716552734375, 442.5411376953125, 429.3595886230469]}, {"text": "Molar enthalpy of methane combustion at 298 K, Δ𝑟𝐻298 = −802.3 kJ mol−1", "bbox": [114.69094848632812, 379.35418701171875, 472.0211181640625, 445.3066101074219]}, {"text": "2 points for the correct answer; 1 point if the answer is incorrect but the calcu-", "bbox": [114.69094848632812, 416.1275634765625, 480.5752258300781, 429.6947937011719]}, {"text": "lation of difference in enthalpies of products and reagents exists.", "bbox": [114.69094848632812, 428.0825500488281, 418.4213562011719, 441.6497802734375]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 322.8695068359375, 521.8194580078125, 336.4367370605469]}, {"text": "Δ𝑓𝐻∘", "bbox": [188.33499145507812, 455.9212341308594, 214.81024169921875, 493.528564453125]}, {"text": "298(CH4)", "bbox": [210.7760009765625, 457.3500061035156, 250.0185546875, 495.74359130859375]}, {"text": "-74.8 kJ mol−1", "bbox": [343.36700439453125, 455.69921875, 408.33319091796875, 486.83056640625]}, {"text": "Δ𝑓𝐻∘", "bbox": [177.114990234375, 472.1012268066406, 203.59124755859375, 509.7095642089844]}, {"text": "298(H2O, gas)", "bbox": [199.55599975585938, 473.5309753417969, 261.2349548339844, 511.924560546875]}, {"text": "-241.8 kJ mol−1", "bbox": [339.3489990234375, 463.6281433105469, 412.3511962890625, 529.58056640625]}, {"text": "Δ𝑓𝐻∘", "bbox": [187.81600952148438, 488.2822265625, 214.29124450683594, 525.8905029296875]}, {"text": "298(CO2)", "bbox": [210.2570037841797, 489.71197509765625, 250.5375518798828, 528.1055297851562]}, {"text": "-393.5 kJ mol−1", "bbox": [340.5190124511719, 488.06121826171875, 411.18121337890625, 519.1925659179688]}, {"text": "𝐶𝑃(CH4)", "bbox": [199.60198974609375, 505.89300537109375, 238.75155639648438, 542.070556640625]}, {"text": "35 J mol−1 K−1", "bbox": [341.7510070800781, 504.2422180175781, 409.9482421875, 535.5945434570312]}, {"text": "𝐶𝑃(H2O, gas)", "bbox": [188.21701049804688, 521.8329467773438, 250.1365509033203, 558.0115356445312]}, {"text": "34 J mol−1 K−1", "bbox": [341.7510070800781, 520.1822509765625, 409.9482421875, 551.5345458984375]}, {"text": "𝐶𝑃(O2)", "bbox": [202.2310028076172, 537.7730102539062, 236.12255859375, 573.9515380859375]}, {"text": "29 J mol−1 K−1", "bbox": [341.7510070800781, 536.1231689453125, 409.9482421875, 567.4755859375]}, {"text": "𝐶𝑃(CO2)", "bbox": [199.0830078125, 553.7129516601562, 239.2705535888672, 589.8915405273438]}, {"text": "37 J mol−1 K−1", "bbox": [341.7510070800781, 552.063232421875, 409.9482421875, 583.41552734375]}, {"text": "If you did not get an answer for 4.6, use Δ𝑟𝐻∘", "bbox": [56.69300079345703, 588.5391845703125, 259.0802307128906, 626.1465454101562]}, {"text": "298 = −750 𝑘𝐽𝑚𝑜𝑙−1 for further calculations.", "bbox": [255.04598999023438, 588.5391845703125, 453.42144775390625, 629.2640991210938]}]}, {"page": 5, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-5", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "4.7", "bbox": [78.60800170898438, 168.87451171875, 92.84233856201172, 182.44174194335938]}, {"text": "Calculate Δ𝑟𝐻2000 (kJ mol−1) per mole of methane combustion reaction at 2000", "bbox": [114.69253540039062, 152.30921936035156, 480.58251953125, 190.1375732421875]}, {"text": "K. Assume all species are gaseous.", "bbox": [114.69099426269531, 180.82949829101562, 277.4087829589844, 194.396728515625]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 192.78550720214844, 169.74588012695312, 206.3527374267578]}, {"text": "Assume constant heat capacities.", "bbox": [114.69100189208984, 204.74050903320312, 269.759521484375, 218.3077392578125]}, {"text": "Δ𝐻(𝑇) = Δ𝐻(298 𝐾) + Δ𝐶𝑝(𝑇−298 𝐾)", "bbox": [114.69100189208984, 201.7799835205078, 293.9414367675781, 237.9585723876953]}, {"text": "Δ𝐶𝑝= [𝐶𝑝(CO2) + 2𝐶𝑝(H2O)] −[𝐶𝑝(CH4) + 2𝐶𝑝(O2)]", "bbox": [114.69100952148438, 203.8321533203125, 347.1630859375, 269.7845764160156]}, {"text": "Δ𝐶𝑝= [37 + 2(34)] −[35 + 2(29)] = 12 J mol−1 K−1", "bbox": [114.69100952148438, 215.02114868164062, 340.25421142578125, 284.9595642089844]}, {"text": "Δ𝑟𝐻∘", "bbox": [114.69102478027344, 246.58224487304688, 138.7732696533203, 284.1895751953125]}, {"text": "2000 = −802.3 kJ mol−1 + (12Jmol−1K−1)(1702 𝐾)", "bbox": [134.73802185058594, 236.65664672851562, 347.9207458496094, 304.0605773925781]}, {"text": "1000", "bbox": [289.968994140625, 255.3502197265625, 307.90179443359375, 286.4815673828125]}, {"text": "= −781.876 kJ mol−1", "bbox": [351.885986328125, 238.108154296875, 446.2412109375, 304.0605773925781]}, {"text": "Δ𝑟𝐻∘", "bbox": [114.69100952148438, 262.5332336425781, 138.77325439453125, 300.14056396484375]}, {"text": "2000 = −781.9 kJ mol−1", "bbox": [134.73800659179688, 254.05914306640625, 240.32920837402344, 320.0115661621094]}, {"text": "For a given value of Δ𝑟𝐻∘", "bbox": [114.69102478027344, 286.4432067871094, 232.6002655029297, 324.0515441894531]}, {"text": "298 = −750 kJ/mol alternative answer will be:", "bbox": [228.56602478027344, 277.97015380859375, 433.1481018066406, 343.9225769042969]}, {"text": "Δ𝑟𝐻2000 = −781.9 𝑘𝐽𝑚𝑜𝑙−1", "bbox": [114.69100952148438, 302.38922119140625, 240.877197265625, 340.9001159667969]}, {"text": "Δ𝑟𝐻∘", "bbox": [114.6910171508789, 319.9752197265625, 138.77325439453125, 357.58355712890625]}, {"text": "2000 = −750 kJ mol−1 + (12 J mol−1K−1)(1702 K)", "bbox": [134.73802185058594, 310.04962158203125, 348.8748474121094, 377.4545593261719]}, {"text": "1000", "bbox": [288.37298583984375, 328.74322509765625, 306.3057861328125, 359.87457275390625]}, {"text": "= −729.576 kJ mol−1", "bbox": [352.8380126953125, 311.50213623046875, 447.19317626953125, 377.4545593261719]}, {"text": "Δ𝑟𝐻2000 = −729.6 kJ mol−1", "bbox": [114.69097900390625, 327.4531555175781, 240.3291778564453, 393.40557861328125]}, {"text": "2 points total:", "bbox": [114.69099426269531, 388.1365051269531, 178.8607635498047, 401.7037353515625]}, {"text": "1 point for the correct heat capacity change calculation.", "bbox": [114.69099426269531, 412.0474853515625, 374.0180969238281, 425.6147155761719]}, {"text": "1 point for the correct enthalpy calculation at 2000 K.", "bbox": [114.69099426269531, 435.95745849609375, 362.0430908203125, 449.5246887207031]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 168.79949951171875, 521.8194580078125, 182.36672973632812]}, {"text": "If you did not get an answer for 4.7, use Δ𝑟𝐻2000 = −700 𝑘𝐽𝑚𝑜𝑙−1 for further calculations.", "bbox": [56.69300079345703, 449.3042297363281, 460.0504455566406, 487.8141174316406]}, {"text": "Assume that methane is flowing out the well at 101.325 kPa and 298 K with volumetric flow Q = 2.2 × 105", "bbox": [56.69300079345703, 469.0482177734375, 538.0841674804688, 500.1795654296875]}, {"text": "m3 per day before it catches fire.", "bbox": [56.6929931640625, 482.4852294921875, 212.8683319091797, 513.6165771484375]}, {"text": "4.8", "bbox": [78.60799407958984, 524.218505859375, 92.84233093261719, 537.7857055664062]}, {"text": "Calculate the total energy released per day, 𝐸, (in J day−1) by complete isother-", "bbox": [114.69253540039062, 507.8742370605469, 480.5799865722656, 543.8931274414062]}, {"text": "mic combustion of methane at T = 2000 K", "bbox": [114.69097900390625, 536.1735229492188, 308.48486328125, 549.74072265625]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 548.1295166015625, 169.74588012695312, 561.6967163085938]}, {"text": "Using", "bbox": [114.69100189208984, 560.0845336914062, 141.60232543945312, 573.6517333984375]}, {"text": "the", "bbox": [150.22760009765625, 560.0845336914062, 165.59954833984375, 573.6517333984375]}, {"text": "flow", "bbox": [174.23745727539062, 560.0845336914062, 194.0045928955078, 573.6517333984375]}, {"text": "as", "bbox": [202.63087463378906, 560.0845336914062, 212.9920196533203, 573.6517333984375]}, {"text": "a", "bbox": [221.62954711914062, 560.0845336914062, 227.2189178466797, 573.6517333984375]}, {"text": "gas", "bbox": [235.84617614746094, 560.0845336914062, 252.33432006835938, 573.6517333984375]}, {"text": "volume", "bbox": [260.97186279296875, 560.0845336914062, 295.7210693359375, 573.6517333984375]}, {"text": "measured", "bbox": [304.3590087890625, 560.0845336914062, 351.5840759277344, 573.6517333984375]}, {"text": "at", "bbox": [360.2093505859375, 560.0845336914062, 369.3932800292969, 