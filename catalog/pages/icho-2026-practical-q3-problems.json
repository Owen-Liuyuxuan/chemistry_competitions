1513671875, 157.55897521972656, 337.411376953125, 192.14910888671875]}, {"text": "3.7", "bbox": [355.15399169921875, 157.55897521972656, 369.0373840332031, 192.14910888671875]}, {"text": "3.8", "bbox": [386.7799987792969, 157.55897521972656, 400.66339111328125, 192.14910888671875]}, {"text": "3.9", "bbox": [418.406005859375, 157.55897521972656, 432.2893981933594, 192.14910888671875]}, {"text": "Total", "bbox": [456.5320129394531, 172.47450256347656, 481.510009765625, 186.04173278808594]}, {"text": "Points", "bbox": [111.81500244140625, 188.41549682617188, 143.0982666015625, 201.98272705078125]}, {"text": "2", "bbox": [169.49099731445312, 188.41549682617188, 175.18739318847656, 201.98272705078125]}, {"text": "0", "bbox": [201.11700439453125, 188.41549682617188, 206.8134002685547, 201.98272705078125]}, {"text": "50", "bbox": [229.89500427246094, 188.41549682617188, 241.29000854492188, 201.98272705078125]}, {"text": "12", "bbox": [261.52099609375, 188.41549682617188, 272.9159851074219, 201.98272705078125]}, {"text": "1", "bbox": [295.9960021972656, 188.41549682617188, 301.6923828125, 201.98272705078125]}, {"text": "9", "bbox": [327.62200927734375, 188.41549682617188, 333.3183898925781, 201.98272705078125]}, {"text": "2", "bbox": [359.24798583984375, 188.41549682617188, 364.9443664550781, 201.98272705078125]}, {"text": "10", "bbox": [388.0249938964844, 188.41549682617188, 399.41998291015625, 201.98272705078125]}, {"text": "1", "bbox": [422.5, 188.41549682617188, 428.1963806152344, 201.98272705078125]}, {"text": "87", "bbox": [463.32501220703125, 188.41549682617188, 474.7200012207031, 201.98272705078125]}, {"text": "Part A", "bbox": [56.29199981689453, 229.9176025390625, 89.92422485351562, 244.84161376953125]}, {"text": "The chemist Nasreddin prepared solutions of different acids with the same pH value. To do this, he", "bbox": [56.69300079345703, 248.91549682617188, 538.57470703125, 262.48272705078125]}, {"text": "took:", "bbox": [56.6929931640625, 260.8704833984375, 80.33490753173828, 274.4377136230469]}, {"text": "- a strong monoprotic acid HA,", "bbox": [56.6929931640625, 278.8034973144531, 199.25848388671875, 292.3707275390625]}, {"text": "- a weak monoprotic acid HB,", "bbox": [56.6929931640625, 296.73651123046875, 193.03184509277344, 310.3037414550781]}, {"text": "- a diprotic acid H2C.", "bbox": [56.6929931640625, 314.6684875488281, 152.70298767089844, 330.4348449707031]}, {"text": "He obtained six solutions (X1–X6), all with the same pH value when rounded to the nearest integer.", "bbox": [56.6929931640625, 332.60150146484375, 538.5678100585938, 346.1687316894531]}, {"text": "These six solutions included three solutions of individual acids and three pairwise mixtures, which con-", "bbox": [56.6929931640625, 344.5564880371094, 538.5718383789062, 358.12371826171875]}, {"text": "tained individual acids in a 1 ∶1 molar ratio (not necessarily in order given below).", "bbox": [56.6929931640625, 341.595947265625, 439.4100341796875, 376.18609619140625]}, {"text": "HA", "bbox": [139.39801025390625, 398.51348876953125, 153.14797973632812, 412.0807189941406]}, {"text": "HB", "bbox": [199.88999938964844, 398.51348876953125, 213.74700927734375, 412.0807189941406]}, {"text": "H2C", "bbox": [257.7130126953125, 398.51348876953125, 277.0167236328125, 414.27984619140625]}, {"text": "HA + HB", "bbox": [308.47900390625, 377.6199645996094, 347.34002685546875, 412.2101135253906]}, {"text": "(1 ∶1)", "bbox": [313.91400146484375, 389.574951171875, 341.9094543457031, 424.16510009765625]}, {"text": "HA + H2C", "bbox": [366.302001953125, 376.4139709472656, 410.6107482910156, 411.0041198730469]}, {"text": "(1 ∶1)", "bbox": [374.46002197265625, 390.7809753417969, 402.4544677734375, 425.3711242675781]}, {"text": "HB + H2C", "bbox": [426.79400634765625, 376.4139709472656, 471.2097473144531, 411.0041198730469]}, {"text": "(1 ∶1)", "bbox": [435.0050048828125, 390.7809753417969, 463.0004577636719, 425.3711242675781]}, {"text": "In this part, you need to perform titrations of solutions X3–X6 with a pH meter. Unfortunately, on the", "bbox": [56.69300079345703, 439.5274963378906, 538.57568359375, 453.0947265625]}, {"text": "way to IChO 2026, Nasreddin lost solutions X1 and X2, but he promises to help in determining their", "bbox": [56.6929931640625, 453.77349853515625, 538.57373046875, 467.3407287597656]}, {"text": "composition.", "bbox": [56.69300842285156, 465.7284851074219, 117.33601379394531, 479.29571533203125]}, {"text": "1. Using a volumetric pipette, transfer 50.0 mL of X3 into a plastic cup.", "bbox": [68.2509994506836, 468.7459716796875, 404.2246398925781, 503.33612060546875]}, {"text": "2. Measure the pH of X3 using the pH meter.", "bbox": [68.2509994506836, 501.59454345703125, 282.1211853027344, 515.1617431640625]}, {"text": "Q3.1", "bbox": [78.60800170898438, 524.5595092773438, 100.77256774902344, 538.126708984375]}, {"text": "Tick the pH value of X3 to the nearest integer.", "bbox": [114.69253540039062, 524.5595092773438, 331.0329895019531, 538.126708984375]}, {"text": "2 pt", "bbox": [495.45001220703125, 524.478515625, 513.4508666992188, 538.0457153320312]}, {"text": "3. Using the pH meter, titrate 50.0 mL of X3 with 0.0100 M NaOH solution by adding 0.5 mL portions", "bbox": [68.2509994506836, 540.3259887695312, 538.5745239257812, 574.9161376953125]}, {"text": "of NaOH solution and measuring the pH of the resulting solution until it reaches ~10. Do not use", "bbox": [81.5999755859375, 567.1964721679688, 538.5657348632812, 580.763671875]}, {"text": "the stirring plate in this experiment.", "bbox": [81.5999984741211, 579.1514892578125, 249.84906005859375, 592.7186889648438]}, {"text": "4. Record the pH values. When a more accurate measurement is required, wait until the displayed", "bbox": [68.2509994506836, 597.08447265625, 538.5794677734375, 610.6516723632812]}, {"text": "pH value is stable for at least 5 seconds.", "bbox": [81.60000610351562, 609.0394897460938, 267.9510803222656, 622.606689453125]}, {"text": "5. Repeat steps 1, 3 and 4 for X4–X6.", "bbox": [68.2509994506836, 626.9724731445312, 243.14263916015625, 640.5396728515625]}, {"text": "Q3.2", "bbox": [78.60800170898438, 649.9375, 100.77256774902344, 663.5046997070312]}, {"text": "Record your results for the titration of solutions X3–X6. You may sketch the", "bbox": [114.69253540039062, 649.9375, 480.5839538574219, 663.5046997070312]}, {"text": "titration curves on the provided grids, but they will not be graded.", "bbox": [114.69100952148438, 664.1845092773438, 422.4861755371094, 677.751708984375]}, {"text": "0 pt", "bbox": [495.45001220703125, 649.8624877929688, 513.4508666992188, 663.4296875]}]}, {"page": 4, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Experiment", "bbox": [56.69300079345703, 63.1240119934082, 138.68612670898438, 82.42530822753906]}, {"text": "Q3-4", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "Q3.3", "bbox": [78.60800170898438, 166.2294921875, 100.77256774902344, 179.79672241210938]}, {"text": "Determine the ranges of NaOH volume (in mL) that correspond to the equiva-", "bbox": [114.69253540039062, 141.4111328125, 480.57421875, 207.36354064941406]}, {"text": "lence points during the titrations of X3–X6. Tick the appropriate boxes based", "bbox": [114.69100952148438, 178.18450927734375, 480.5726013183594, 191.75173950195312]}, {"text": "on your results from Q3.2.", "bbox": [114.69099426269531, 190.1405029296875, 237.73562622070312, 203.70773315429688]}, {"text": "For example, if the equivalence point lies in the range 4.0 < 𝑉", "bbox": [114.69098663330078, 187.1799774169922, 421.2494201660156, 221.77011108398438]}, {"text": "≤4.5, you", "bbox": [429.478515625, 187.1799774169922, 480.5826721191406, 221.77011108398438]}, {"text": "must tick the box as shown below:", "bbox": [114.69100952148438, 214.05050659179688, 279.1488952636719, 227.61773681640625]}, {"text": "50 pt", "bbox": [495.45001220703125, 166.15451049804688, 519.1494750976562, 179.72174072265625]}, {"text": "Nasreddin provides the following titration curve of 50.0 mL X1 with 0.0100 M NaOH solution, where", "bbox": [56.69300079345703, 296.03851318359375, 538.59228515625, 309.6057434082031]}, {"text": "𝑉1 = 34.75 mL:", "bbox": [56.6929931640625, 293.0789794921875, 123.70907592773438, 330.15911865234375]}, {"text": "He also notes that for solution X2, the ratio between the total 𝑉(NaOH) to reach the second equivalence", "bbox": [56.69300079345703, 529.5180053710938, 538.578369140625, 564.108154296875]}, {"text": "point relative to 𝑉(NaOH) to reach the first equivalence point is approximately 3 ∶2.", "bbox": [56.6929931640625, 541.4729614257812, 448.8322448730469, 576.0631103515625]}, {"text": "Q3.4", "bbox": [78.60800170898438, 579.3544921875, 100.77256774902344, 592.9216918945312]}, {"text": "Determine the composition of X1–X6. Tick the appropriate boxes.", "bbox": [114.69253540039062, 579.3544921875, 426.3583984375, 592.9216918945312]}, {"text": "12 pt", "bbox": [495.45001220703125, 579.2734985351562, 519.1494750976562, 592.8406982421875]}, {"text": "Q3.5", "bbox": [78.60800170898438, 615.0684814453125, 100.77256774902344, 628.6356811523438]}, {"text": "Give the pH of the resulting solution after mixing equal volumes of X1–X6.", "bbox": [114.69253540039062, 615.0684814453125, 462.89263916015625, 628.6356811523438]}, {"text": "1 pt", "bbox": [495.45001220703125, 614.9375, 513.4508666992188, 628.5046997070312]}]}, {"page": 5, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Experiment", "bbox": [56.69300079345703, 63.1240119934082, 138.68612670898438, 82.42530822753906]}, {"text": "Q3-5", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "Part B", "bbox": [56.29199981689453, 154.15460205078125, 89.72624206542969, 169.07861328125]}, {"text": "Nasreddin also prepared universal indicators Y1 and Y2 for acid−base titration. To prepare Y2, he made", "bbox": [56.69300079345703, 173.15249633789062, 538.5765991210938, 186.7197265625]}, {"text": "an extract from red cabbage.", "bbox": [56.693023681640625, 185.10751342773438, 192.33448791503906, 198.67474365234375]}, {"text": "Prepare a fresh solution of Y2 from red cabbage as follows:", "bbox": [56.693023681640625, 203.04049682617188, 335.7077941894531, 216.6077423095703]}, {"text": "1. Transfer all the sliced red cabbage into the 200 mL glass beaker with 60 mL of water.", "bbox": [68.2509994506836, 223.3175048828125, 477.5854797363281, 236.88473510742188]}, {"text": "2. Place the beaker on the hotplate and heat it at 70–95∘C for 20 min.", "bbox": [68.2509994506836, 224.90521240234375, 394.5228576660156, 256.03656005859375]}, {"text": "3. Filter the extract through the funnel with cotton wool and collect the Y2 solution in the clean", "bbox": [68.2509994506836, 259.1835021972656, 538.5775756835938, 272.750732421875]}, {"text": "200 mL glass beaker.", "bbox": [81.60000610351562, 271.13848876953125, 178.86553955078125, 284.7057189941406]}, {"text": "4. Determine the order of colour transitions of Y2 as pH changes using the available solutions and", "bbox": [68.2509994506836, 289.0715026855469, 538.5719604492188, 302.63873291015625]}, {"text": "equipment. Using 100 μL of Y2 per 1 mL of analyte provides the most reliable results.", "bbox": [81.60000610351562, 276.2081298828125, 477.6041259765625, 342.1605529785156]}, {"text": "Q3.6", "bbox": [78.60801696777344, 323.99151611328125, 100.7725830078125, 337.5587463378906]}, {"text": "Arrange the colours of Y2 in order of increasing pH using the colour abbrevia-", "bbox": [114.69255065917969, 323.99151611328125, 480.5662841796875, 337.5587463378906]}, {"text": "tions listed below.", "bbox": [114.69100952148438, 338.2375183105469, 198.805908203125, 351.80474853515625]}, {"text": "Red/pink", "bbox": [142.2519989013672, 364.82550048828125, 184.0767822265625, 378.3927307128906]}, {"text": "Yellow", "bbox": [215.4459991455078, 364.82550048828125, 245.3650360107422, 378.3927307128906]}, {"text": "Green", "bbox": [283.30401611328125, 364.82550048828125, 311.9779968261719, 378.3927307128906]}, {"text": "Blue", "bbox": [354.4630126953125, 364.82550048828125, 375.28448486328125, 378.3927307128906]}, {"text": "Violet", "bbox": [418.9309997558594, 364.82550048828125, 445.2904357910156, 378.3927307128906]}, {"text": "R", "bbox": [160.0679931640625, 380.7665100097656, 166.2654266357422, 394.333740234375]}, {"text": "Y", "bbox": [227.58299255371094, 380.7665100097656, 233.22100830078125, 394.333740234375]}, {"text": "G", "bbox": [294.010986328125, 380.7665100097656, 301.2640380859375, 394.333740234375]}, {"text": "B", "bbox": [361.635986328125, 380.7665100097656, 368.1107177734375, 394.333740234375]}, {"text": "V", "bbox": [429.1189880371094, 380.7665100097656, 435.0975341796875, 394.333740234375]}, {"text": "9 pt", "bbox": [495.45001220703125, 323.9104919433594, 513.4508666992188, 337.47772216796875]}, {"text": "The extract of red cabbage contains anthocyanins responsible for such a wide range of colours. Below", "bbox": [56.69300079345703, 427.2984924316406, 538.5552978515625, 440.86572265625]}, {"text": "are the structures of anthocyanins at different pH:", "bbox": [56.69300079345703, 439.25347900390625, 291.0040588378906, 452.8207092285156]}, {"text": "Q3.7", "bbox": [78.60800170898438, 557.510498046875, 100.77256774902344, 571.0776977539062]}, {"text": "Arrange A–D according to which structures are most dominant as the pH is", "bbox": [114.69253540039062, 557.510498046875, 480.5636901855469, 571.0776977539062]}, {"text": "changed from low to high.", "bbox": [114.69100189208984, 571.8095092773438, 238.01869201660156, 585.376708984375]}, {"text": "2 pt", "bbox": [495.45001220703125, 557.4295043945312, 513.4508666992188, 570.9967041015625]}]}, {"page": 6, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Experiment", "bbox": [56.69300079345703, 63.1240119934082, 138.68612670898438, 82.42530822753906]}, {"text": "Q3-6", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "To prepare Y1, Nasreddin mixed two individual indicators from the table:", "bbox": [56.69300079345703, 155.21949768066406, 396.44189453125, 168.78672790527344]}, {"text": "#", "bbox": [89.31300354003906, 190.03750610351562, 95.7488021850586, 203.604736328125]}, {"text": "Indicator", "bbox": [202.3939971923828, 190.03750610351562, 248.3126220703125, 203.604736328125]}, {"text": "pH range of colour changes", "bbox": [362.2460021972656, 190.03750610351562, 498.66473388671875, 203.604736328125]}, {"text": "1", "bbox": [89.68299865722656, 205.97750854492188, 95.37938690185547, 219.54473876953125]}, {"text": "Bromophenol blue (BPB)", "bbox": [167.46200561523438, 205.97750854492188, 283.2528381347656, 219.54473876953125]}, {"text": "yellow < 3.0 – 4.6 < blue", "bbox": [375.41400146484375, 205.97750854492188, 485.5202941894531, 219.54473876953125]}, {"text": "2", "bbox": [89.68299865722656, 221.9185028076172, 95.37938690185547, 235.48573303222656]}, {"text": "Congo red (CR)", "bbox": [190.1179962158203, 221.9185028076172, 260.5958557128906, 235.48573303222656]}, {"text": "blue < 3.0 – 5.2 < red", "bbox": [382.3290100097656, 221.9185028076172, 478.6098937988281, 235.48573303222656]}, {"text": "3", "bbox": [89.68299865722656, 237.85850524902344, 95.37938690185547, 251.4257354736328]}, {"text": "Bromocresol green (BG)", "bbox": [169.23199462890625, 237.85850524902344, 281.4818420410156, 251.4257354736328]}, {"text": "yellow < 3.8 – 5.4 < blue", "bbox": [375.41400146484375, 237.85850524902344, 485.5202941894531, 251.4257354736328]}, {"text": "4", "bbox": [89.68299865722656, 253.79852294921875, 95.37938690185547, 267.3657531738281]}, {"text": "Methyl red (MR)", "bbox": [187.88600158691406, 253.79852294921875, 262.828857421875, 267.3657531738281]}, {"text": "red < 4.4 – 6.2 < yellow", "bbox": [377.76800537109375, 253.79852294921875, 483.1836242675781, 267.3657531738281]}, {"text": "5", "bbox": [89.68299865722656, 269.7384948730469, 95.37938690185547, 283.30572509765625]}, {"text": "Chlorophenol red (CPR)", "bbox": [170.43099975585938, 269.7384948730469, 280.2828369140625, 283.30572509765625]}, {"text": "yellow < 5.2 – 6.8 < purple", "bbox": [370.2919921875, 269.7384948730469, 490.63983154296875, 283.30572509765625]}, {"text": "6", "bbox": [89.68299865722656, 285.67950439453125, 95.37938690185547, 299.2467346191406]}, {"text": "Bromothymol blue (BTB)", "bbox": [167.73599243164062, 285.67950439453125, 282.97784423828125, 299.2467346191406]}, {"text": "yellow < 6.0 – 7.6 < blue", "bbox": [375.41400146484375, 285.67950439453125, 485.5202941894531, 299.2467346191406]}, {"text": "7", "bbox": [89.68299865722656, 301.6195068359375, 95.37938690185547, 315.1867370605469]}, {"text": "Phenol red (PR)", "bbox": [189.20401000976562, 301.6195068359375, 261.5108642578125, 315.1867370605469]}, {"text": "yellow < 6.8 – 8.2 < pink", "bbox": [375.56201171875, 301.6195068359375, 485.3715515136719, 315.1867370605469]}, {"text": "8", "bbox": [89.68299865722656, 317.55950927734375, 95.37938690185547, 331.1267395019531]}, {"text": "Thymol blue (TB)", "bbox": [185.968994140625, 317.55950927734375, 264.745849609375, 331.1267395019531]}, {"text": "yellow < 8.0 – 9.6 < blue", "bbox": [375.41400146484375, 317.55950927734375, 485.5202941894531, 331.1267395019531]}, {"text": "9", "bbox": [89.68299865722656, 333.49951171875, 95.37938690185547, 347.0667419433594]}, {"text": "Phenolphthalein (PP)", "bbox": [176.2689971923828, 333.49951171875, 274.4458312988281, 347.0667419433594]}, {"text": "colourless < 8.2 – 10.0 < pink", "bbox": [363.8070068359375, 333.49951171875, 497.1283264160156, 347.0667419433594]}, {"text": "10", "bbox": [86.83499908447266, 349.44049072265625, 98.22999572753906, 363.0077209472656]}, {"text": "Alizarin yellow R (AYR)", "bbox": [173.59300231933594, 349.44049072265625, 277.120849609375, 363.0077209472656]}, {"text": "yellow < 10.1 – 12.0 < red", "bbox": [372.0719909667969, 349.44049072265625, 488.88580322265625, 363.0077209472656]}, {"text": "Determine the pH ranges of the colour changes of Y1 using the pH meter and available solutions. Using", "bbox": [56.69300079345703, 383.2715148925781, 538.5721435546875, 396.8387451171875]}, {"text": "5 μL of Y1 per 1 mL of analyte provides the most reliable results.", "bbox": [56.69300842285156, 370.40814208984375, 354.3931579589844, 436.3605651855469]}, {"text": "Q3.8", "bbox": [78.6080093383789, 418.1914978027344, 100.77257537841797, 431.75872802734375]}, {"text": "Tick the appropriate boxes for the pH ranges of the colour changes of Y1.", "bbox": [114.69255065917969, 418.1914978027344, 459.87664794921875, 431.75872802734375]}, {"text": "10 pt", "bbox": [495.45001220703125, 418.1155090332031, 519.1494750976562, 431.6827392578125]}, {"text": "Q3.9", "bbox": [78.60800170898438, 453.906494140625, 100.77256774902344, 467.4737243652344]}, {"text": "Determine the composition of Y1. Tick the appropriate boxes.", "bbox": [114.69253540039062, 453.906494140625, 408.607421875, 467.4737243652344]}, {"text": "1 pt", "bbox": [495.45001220703125, 453.7745056152344, 513.4508666992188, 467.34173583984375]}]}]