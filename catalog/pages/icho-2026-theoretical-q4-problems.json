[{"page": 1, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-1", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "T4. The nuclear past of Uzbekistan", "bbox": [56.69300079345703, 151.06434631347656, 330.6927185058594, 172.77197265625]}, {"text": "6%", "bbox": [290.6499938964844, 193.70750427246094, 304.6280822753906, 207.2747344970703]}, {"text": "4.1", "bbox": [141.0570068359375, 209.6475067138672, 155.12197875976562, 223.21473693847656]}, {"text": "4.2", "bbox": [172.68299865722656, 209.6475067138672, 186.7479705810547, 223.21473693847656]}, {"text": "4.3", "bbox": [204.3090057373047, 209.6475067138672, 218.37399291992188, 223.21473693847656]}, {"text": "4.4", "bbox": [235.93499755859375, 209.6475067138672, 249.99998474121094, 223.21473693847656]}, {"text": "4.5", "bbox": [267.5610046386719, 209.6475067138672, 281.6259765625, 223.21473693847656]}, {"text": "4.6", "bbox": [299.18701171875, 209.6475067138672, 313.2519836425781, 223.21473693847656]}, {"text": "4.7", "bbox": [330.81298828125, 209.6475067138672, 344.8779602050781, 223.21473693847656]}, {"text": "4.8", "bbox": [362.4389953613281, 209.6475067138672, 376.50396728515625, 223.21473693847656]}, {"text": "4.9", "bbox": [394.06500244140625, 209.6475067138672, 408.1299743652344, 223.21473693847656]}, {"text": "∑", "bbox": [436.81201171875, 209.6475067138672, 443.0970153808594, 223.21473693847656]}, {"text": "2", "bbox": [145.24099731445312, 225.5885009765625, 150.93739318847656, 239.15573120117188]}, {"text": "3", "bbox": [176.86700439453125, 225.5885009765625, 182.5634002685547, 239.15573120117188]}, {"text": "3", "bbox": [208.4929962158203, 225.5885009765625, 214.18939208984375, 239.15573120117188]}, {"text": "2", "bbox": [240.11900329589844, 225.5885009765625, 245.81539916992188, 239.15573120117188]}, {"text": "2", "bbox": [271.7449951171875, 225.5885009765625, 277.4413757324219, 239.15573120117188]}, {"text": "2", "bbox": [303.3710021972656, 225.5885009765625, 309.0673828125, 239.15573120117188]}, {"text": "2", "bbox": [334.99700927734375, 225.5885009765625, 340.6933898925781, 239.15573120117188]}, {"text": "2", "bbox": [366.62298583984375, 225.5885009765625, 372.3193664550781, 239.15573120117188]}, {"text": "4", "bbox": [398.2489929199219, 225.5885009765625, 403.94537353515625, 239.15573120117188]}, {"text": "22", "bbox": [434.25799560546875, 225.5885009765625, 445.6529846191406, 239.15573120117188]}, {"text": "Natural uranium consists primarily of two isotopes, 235U and 238U", "bbox": [56.69300079345703, 245.60623168945312, 374.0386047363281, 280.7225646972656]}, {"text": ". 235U is responsible for sustaining", "bbox": [371.4606018066406, 245.60623168945312, 538.576416015625, 280.7225646972656]}, {"text": "nuclear fission reactions.", "bbox": [56.6929931640625, 273.905517578125, 172.9571990966797, 287.4727478027344]}, {"text": "4.1", "bbox": [78.60799407958984, 299.4024963378906, 92.84233093261719, 312.9697265625]}, {"text": "Calculate the atomic abundance of 235U in natural uranium, assuming it con-", "bbox": [114.69253540039062, 283.0581970214844, 480.5711669921875, 318.174560546875]}, {"text": "sists only of isotopes 235U (235.04 a.u.) and 238U (238.05 a.u.).", "bbox": [114.69100952148438, 297.5932312011719, 402.1573181152344, 332.7095642089844]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 299.3265075683594, 521.8194580078125, 312.89373779296875]}, {"text": "The main reaction occurring in nuclear power plants is the reaction where 235U absorbs a neutron and", "bbox": [56.69300079345703, 327.28424072265625, 538.56884765625, 362.40057373046875]}, {"text": "undergoes fission, releasing energy and producing three additional neutrons, thus sustaining a chain", "bbox": [56.692962646484375, 355.58349609375, 538.5458374023438, 369.1507263183594]}, {"text": "reaction.", "bbox": [56.692962646484375, 367.53948974609375, 97.72957611083984, 381.1067199707031]}, {"text": "235", "bbox": [249.4199676513672, 381.08221435546875, 262.86956787109375, 412.21356201171875]}, {"text": "92 U +1", "bbox": [249.4199676513672, 381.08221435546875, 284.17218017578125, 421.0305480957031]}, {"text": "0 n →… + 31", "bbox": [279.68896484375, 381.0822448730469, 339.19818115234375, 420.9045715332031]}, {"text": "0n", "bbox": [334.7149963378906, 389.77325439453125, 345.8554992675781, 420.90460205078125]}, {"text": "Neutrons that induce the chain reaction are produced by several ways:", "bbox": [56.6929931640625, 422.9765319824219, 386.23651123046875, 436.54376220703125]}, {"text": "a) Reaction of 11B with 𝛼-particles inside the reactor core", "bbox": [56.6929931640625, 426.0452575683594, 320.5979919433594, 462.0651550292969]}, {"text": "b) Interaction of 𝛾rays with 2D nuclei present in the reactor coolant water", "bbox": [56.69300079345703, 445.4592590332031, 400.4232177734375, 481.4781494140625]}, {"text": "c) Reaction of 9Be with 𝛼-particles produced in an externally installed neutron source.", "bbox": [56.69300079345703, 464.8732604980469, 454.2066955566406, 500.89215087890625]}, {"text": "4.2", "bbox": [78.60800170898438, 504.18353271484375, 92.84233856201172, 517.750732421875]}, {"text": "Write the nuclear reaction equations for (a), (b), and (c).", "bbox": [114.69254302978516, 504.18353271484375, 377.839599609375, 517.750732421875]}, {"text": "3.0 pt", "bbox": [495.4499816894531, 504.10748291015625, 521.8193969726562, 517.6746826171875]}]}, {"page": 2, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-2", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "The graph above displays the percentage yield, P(A), of fission products by mass number, A, resulting", "bbox": [56.69300079345703, 492.5255126953125, 538.5911865234375, 506.0927429199219]}, {"text": "from 235U fission.", "bbox": [56.6929931640625, 489.7252502441406, 138.848876953125, 524.841552734375]}, {"text": "4.3", "bbox": [78.60799407958984, 531.5665283203125, 92.84233093261719, 545.1337280273438]}, {"text": "Write the main nuclear fission equation for splitting of 235U upon neutron ab-", "bbox": [114.69253540039062, 515.22216796875, 480.56903076171875, 550.3385009765625]}, {"text": "sorption. The pair of elements formed in this reaction are in the same group of", "bbox": [114.69100952148438, 543.521484375, 480.5599365234375, 557.0886840820312]}, {"text": "Periodic Table.", "bbox": [114.69100952148438, 555.4774780273438, 182.8458251953125, 569.044677734375]}, {"text": "3.0 pt", "bbox": [495.45001220703125, 531.4915161132812, 521.8194580078125, 545.0587158203125]}, {"text": "4.4", "bbox": [78.60800170898438, 587.948486328125, 92.84233856201172, 601.5156860351562]}, {"text": "Calculate the energy released in this reaction (ΔE, MeV), if the binding energy", "bbox": [114.69253540039062, 587.948486328125, 480.5744934082031, 601.5156860351562]}, {"text": "𝐵𝐸(235U) = 7.59 MeV/nucleon and average binding energy for fission products", "bbox": [114.69100952148438, 586.13818359375, 480.56597900390625, 622.1580810546875]}, {"text": "𝐵𝐸(fis.) = 8.45 MeV/nucleon. Neglect the binding energy of free neutrons.", "bbox": [114.69100952148438, 589.6201171875, 458.55596923828125, 655.572509765625]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 587.8724975585938, 521.8194580078125, 601.439697265625]}, {"text": "Fission neutrons are produced with an average energy of 2 MeV and slow down through many scatterings", "bbox": [56.69300079345703, 644.1295166015625, 538.5442504882812, 657.6967163085938]}, {"text": "with nuclei. After several collisions, their speed decreases until their average kinetic energy matches that", "bbox": [56.69300079345703, 656.0845336914062, 538.5823364257812, 669.6517333984375]}, {"text": "of the surrounding atoms or molecules.", "bbox": [56.69300079345703, 668.03955078125, 242.3865966796875, 681.6067504882812]}, {"text": "The logarithmic energy decrement, 𝜉, shows the average decrease per collision in the logarithm of", "bbox": [56.69300079345703, 671.0570068359375, 538.5692138671875, 705.6471557617188]}, {"text": "the neutron energy:", "bbox": [56.6929931640625, 697.9275512695312, 150.3122100830078, 711.4947509765625]}, {"text": "𝜉= ln (", "bbox": [259.22698974609375, 719.75, 294.83575439453125, 762.0961303710938]}, {"text": "𝐸𝑖𝑛𝑖𝑡𝑖𝑎𝑙", "bbox": [296.031982421875, 712.3679809570312, 326.1258544921875, 748.5465698242188]}, {"text": "𝐸𝑓𝑖𝑛𝑎𝑙)", "bbox": [297.197021484375, 726.7239990234375, 336.0487976074219, 762.902587890625]}, {"text": "𝐸𝑖𝑛𝑖𝑡𝑖𝑎𝑙and 𝐸𝑓𝑖𝑛𝑎𝑙are the initial and final neutron energies per collision.", "bbox": [56.69300842285156, 753.1510620117188, 391.50830078125, 789.3296508789062]}]}, {"page": 3, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q4-3", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "𝜉is a constant for each type of material and does not depend on the initial neutron energy.", "bbox": [56.69300079345703, 140.30397033691406, 481.7059326171875, 174.89410400390625]}, {"text": "4.5", "bbox": [78.60800170898438, 178.1844940185547, 92.84233856201172, 191.75172424316406]}, {"text": "Determine the average number of collisions required, n𝑐, to slow a neutron", "bbox": [114.69253540039062, 168.31622314453125, 480.5860290527344, 199.44757080078125]}, {"text": "from 2 MeV to 0.012 eV, using water as the moderator. 𝜉(water)=0.948", "bbox": [114.69100952148438, 175.2249755859375, 444.91192626953125, 209.81512451171875]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 178.1094970703125, 521.8194580078125, 191.67672729492188]}, {"text": "In 1963, the Urtabulak gas field suffered an uncontrolled natural gas well blowout, releasing enormous", "bbox": [56.69300079345703, 219.8314971923828, 538.5543212890625, 233.3987274169922]}, {"text": "volumes of burning methane.", "bbox": [56.6929931640625, 231.7864990234375, 195.5623321533203, 245.35372924804688]}, {"text": "4.6", "bbox": [78.60799407958984, 257.396484375, 92.84233093261719, 270.9637145996094]}, {"text": "Calculate Δ𝑟𝐻∘", "bbox": [114.69253540039062, 241.05120849609375, 188.13525390625, 278.6595764160156]}, {"text": "298 (kJ mol−1) for one mole of methane combustion reaction at", "bbox": [184.10000610351562, 240.83023071289062, 480.57318115234375, 280.8745422363281]}, {"text": "298 K. Assume all species are gaseous. Use the thermodynamic data below", "bbox": [114.69099426269531, 270.865478515625, 467.3782043457031, 284.4327392578125]}, {"text": "2.0 pt", "bbox": [495.4499816894531, 257.32049560546875, 521.8193969726562, 270.8877258300781]}, {"text": "Δ𝑓𝐻∘", "bbox": [188.33499145507812, 299.6942443847656, 214.81024169921875, 337.3025817871094]}, {"text": "298(CH4)", "bbox": [210.7760009765625, 301.1239929199219, 250.0185546875, 339.517578125]}, {"text": "-74.8 kJ mol−1", "bbox": [343.36700439453125, 299.4732360839844, 408.33319091796875, 330.6045837402344]}, {"text": "Δ𝑓𝐻∘", "bbox": [177.114990234375, 315.8752136230469, 203.59124755859375, 353.4835510253906]}, {"text": "298(H2O, gas)", "bbox": [199.55599975585938, 317.3049621582031, 261.2349548339844, 355.69854736328125]}, {"text": "-241.8 kJ mol−1", "bbox": [339.3489990234375, 307.4021301269531, 412.3511962890625, 373.35455322265625]}, {"text": "Δ𝑓𝐻∘", "bbox": [187.81600952148438, 332.05621337890625, 214.29124450683594, 369.66455078125]}, {"text": "298(CO2)", "bbox": [210.2570037841797, 333.4859924316406, 250.5375518798828, 371.8785705566406]}, {"text": "-393.5 kJ mol−1", "bbox": [340.5190124511719, 331.835205078125, 411.18121337890625, 362.966552734375]}, {"text": "𝐶𝑃(CH4)", "bbox": [199.60198974609375, 349.6659851074219, 238.75155639648438, 385.8445739746094]}, {"text": "35 J mol−1 K−1", "bbox": [341.7510070800781, 348.0162353515625, 409.9482421875, 379.36859130859375]}, {"text": "𝐶𝑃(H2O, gas)", "bbox": [188.21701049804688, 365.6069641113281, 250.1365509033203, 401.7855529785156]}, {"text": "34 J mol−1 K−1", "bbox": [341.7510070800781, 363.9562072753906, 409.9482421875, 395.3085632324219]}, {"text": "𝐶𝑃(O2)", "bbox": [202.2310028076172, 381.5469665527344, 236.12255859375, 417.7255554199219]}, {"text": "29 J mol−1 K−1", "bbox": [341.7510070800781, 379.8962097167969, 409.9482421875, 411.2485656738281]}, {"text": "𝐶𝑃(CO2)", "bbox": [199.0830078125, 397.4869689941406, 239.2705535888672, 433.6655578613281]}, {"text": "37 J mol−1 K−1", "bbox": [341.7510070800781, 395.83721923828125, 409.9482421875, 427.1895751953125]}, {"text": "If you did not get an answer for 4.6, use Δ𝑟𝐻∘", "bbox": [56.69300079345703, 432.313232421875, 259.0802307128906, 469.9205627441406]}, {"text": "298 = −750 𝑘𝐽𝑚𝑜𝑙−1 for further calculations.", "bbox": [255.04598999023438, 432.3132629394531, 453.42144775390625, 473.03814697265625]}, {"text": "4.7", "bbox": [78.60800170898438, 474.2674865722656, 92.84233856201172, 487.834716796875]}, {"text": "Calculate Δ𝑟𝐻2000 (kJ mol−1) per mole of methane combustion reaction at 2000", "bbox": [114.69253540039062, 457.70220947265625, 480.58251953125, 495.5305480957031]}, {"text": "K. Assume all species are gaseous.", "bbox": [114.69099426269531, 486.22247314453125, 277.4087829589844, 499.78973388671875]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 474.1925048828125, 521.8194580078125, 487.7597351074219]}, {"text": "If you did not get an answer for 4.7, use Δ𝑟𝐻2000 = −700 𝑘𝐽𝑚𝑜𝑙−1 for further calculations.", "bbox": [56.69300079345703, 500.5602111816406, 460.0504455566406, 539.0711059570312]}, {"text": "Assume that methane is flowing out the well at 101.325 kPa and 298 K with volumetric flow Q = 2.2 × 105", "bbox": [56.69300079345703, 520.30517578125, 538.0841674804688, 551.4365234375]}, {"text": "m3 per day before it catches fire.", "bbox": [56.6929931640625, 533.7412109375, 212.8683319091797, 564.87255859375]}, {"text": "4.8", "bbox": [78.60799407958984, 575.4755249023438, 92.84233093261719, 589.042724609375]}, {"text": "Calculate the total energy released per day, 𝐸, (in J day−1) by complete isother-", "bbox": [114.69253540039062, 559.1302490234375, 480.5799865722656, 595.150146484375]}, {"text": "mic combustion of methane at T = 2000 K", "bbox": [114.69097900390625, 587.4305419921875, 308.48486328125, 600.9977416992188]}, {"text": "2.0 pt", "bbox": [495.4499816894531, 575.3995361328125, 521.8193969726562, 588.9667358398438]}, {"text": "The Urtabulak gas leak was ended by detonating a 30-kiloton in TNT equivalent underground nuclear", "bbox": [56.69300079345703, 614.8255004882812, 538.5570068359375, 628.3927001953125]}, {"text": "explosion that collapsed the reservoir and sealed the leak. 1 ton of TNT equivalent is 4.184 GJ of energy.", "bbox": [56.6930046081543, 626.780517578125, 538.5947265625, 640.3477172851562]}, {"text": "4.9", "bbox": [78.60800170898438, 649.7455444335938, 92.84233856201172, 663.312744140625]}, {"text": "Using the value from 4.4, calculate the total number of fissions, TN, during", "bbox": [114.69100952148438, 649.7454833984375, 480.5716247558594, 663.312744140625]}, {"text": "the nuclear explosion. Calculate the mass, m, of enriched uranium used in the", "bbox": [114.69097900390625, 661.7014770507812, 480.5631103515625, 675.2686767578125]}, {"text": "explosion (in kg), assuming it contained 90% by mass of the 235U isotope, and", "bbox": [114.69099426269531, 659.89111328125, 480.5837707519531, 695.0084838867188]}, {"text": "33% of the 235U underwent fission.", "bbox": [114.69097900390625, 673.4351806640625, 277.7012634277344, 708.552490234375]}, {"text": "If you did not get an answer for 4.4, use Δ𝐸= 200 MeV.", "bbox": [114.69100189208984, 686.8199462890625, 359.1912536621094, 721.4100952148438]}, {"text": "4.0 pt", "bbox": [495.45001220703125, 649.6704711914062, 521.8194580078125, 663.2376708984375]}]}]