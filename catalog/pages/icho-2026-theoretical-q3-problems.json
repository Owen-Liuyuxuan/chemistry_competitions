[{"page": 1, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-1", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "T3. Into Reticular Chemistry", "bbox": [56.69300079345703, 150.9783477783203, 280.6503601074219, 172.68597412109375]}, {"text": "7%", "bbox": [290.6499938964844, 193.6215057373047, 304.6280822753906, 207.18873596191406]}, {"text": "3.1", "bbox": [172.68299865722656, 209.5625, 186.7479705810547, 223.12973022460938]}, {"text": "3.2", "bbox": [204.3090057373047, 209.5625, 218.37399291992188, 223.12973022460938]}, {"text": "3.3", "bbox": [235.93499755859375, 209.5625, 249.99998474121094, 223.12973022460938]}, {"text": "3.4", "bbox": [267.5610046386719, 209.5625, 281.6259765625, 223.12973022460938]}, {"text": "3.5", "bbox": [299.18701171875, 209.5625, 313.2519836425781, 223.12973022460938]}, {"text": "3.6", "bbox": [330.81298828125, 209.5625, 344.8779602050781, 223.12973022460938]}, {"text": "3.7", "bbox": [362.4389953613281, 209.5625, 376.50396728515625, 223.12973022460938]}, {"text": "∑", "bbox": [403.7760009765625, 194.6659698486328, 412.8818054199219, 229.256103515625]}, {"text": "2", "bbox": [176.86700439453125, 225.50250244140625, 182.5634002685547, 239.06973266601562]}, {"text": "3", "bbox": [208.4929962158203, 225.50250244140625, 214.18939208984375, 239.06973266601562]}, {"text": "23", "bbox": [237.27099609375, 225.50250244140625, 248.66600036621094, 239.06973266601562]}, {"text": "12", "bbox": [268.8970031738281, 225.50250244140625, 280.2919921875, 239.06973266601562]}, {"text": "6", "bbox": [303.3710021972656, 225.50250244140625, 309.0673828125, 239.06973266601562]}, {"text": "12", "bbox": [332.14898681640625, 225.50250244140625, 343.5439758300781, 239.06973266601562]}, {"text": "5", "bbox": [366.62298583984375, 225.50250244140625, 372.3193664550781, 239.06973266601562]}, {"text": "63", "bbox": [402.6319885253906, 225.50250244140625, 414.0269775390625, 239.06973266601562]}, {"text": "Covalent organic frameworks (COFs) are a class of polymers that form two- or three-dimensional struc-", "bbox": [56.69300079345703, 234.51513671875, 538.5785522460938, 300.4675598144531]}, {"text": "tures through reactions between organic precursors, resulting in covalent bonds to afford porous, crys-", "bbox": [56.69300842285156, 271.28851318359375, 538.5419311523438, 284.8557434082031]}, {"text": "talline materials. Two examples of honeycomb type 2D-COFs formed by boronate ester and boroxine", "bbox": [56.69300842285156, 258.4251403808594, 538.5701904296875, 324.3775634765625]}, {"text": "rings (repeat units indicated using dashed lines) are shown in the figure below.", "bbox": [56.6929931640625, 295.198486328125, 424.9312438964844, 308.7657165527344]}, {"text": "The black and red bold lines represent different building blocks in all COF topology figures.", "bbox": [56.6929931640625, 288.3131408691406, 461.5097961425781, 354.26556396484375]}, {"text": "3.1", "bbox": [78.60800170898438, 618.0264892578125, 92.84233856201172, 631.5936889648438]}, {"text": "Determine the empirical formula of COF-1 and calculate the mass percentage", "bbox": [114.69253540039062, 618.0264892578125, 480.5818176269531, 631.5936889648438]}, {"text": "(%, to two decimal places) of carbon in COF-1.", "bbox": [114.69100952148438, 629.9815063476562, 327.63262939453125, 643.5487060546875]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 617.9505004882812, 521.8194580078125, 631.5177001953125]}]}, {"page": 2, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-2", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "3.2", "bbox": [78.60800170898438, 167.35350036621094, 92.84233856201172, 180.9207305908203]}, {"text": "Calculate the internal diameter, d, in Å, of the honeycomb for COF-2, with the", "bbox": [114.69253540039062, 167.35350036621094, 480.5763854980469, 180.9207305908203]}, {"text": "following assumptions:", "bbox": [114.69097900390625, 179.30850219726562, 223.01499938964844, 192.875732421875]}, {"text": "• C–C/C=C (arenes) = 1.39 Å", "bbox": [130.87100219726562, 191.2635040283203, 259.1009826660156, 204.8307342529297]}, {"text": "• C–B = 1.56 Å", "bbox": [130.87100219726562, 208.20050048828125, 196.94432067871094, 221.76773071289062]}, {"text": "• B–O = 1.38 Å", "bbox": [130.87100219726562, 225.13650512695312, 198.4287567138672, 238.7037353515625]}, {"text": "• Note, the diameter of a circle, 𝑑, inscribed inside a hexagon, is given by", "bbox": [130.87100219726562, 227.15797424316406, 480.5757141113281, 261.74810791015625]}, {"text": "𝑑= √3𝑎, where 𝑎is the side length of the hexagon.", "bbox": [139.59799194335938, 240.89898681640625, 377.6703796386719, 275.96710205078125]}, {"text": "• Neglect the width of the linkers.", "bbox": [130.87100219726562, 273.228515625, 288.6092834472656, 286.7957458496094]}, {"text": "3.0 pt", "bbox": [495.4499816894531, 167.27749633789062, 521.8193969726562, 180.8447265625]}]}, {"page": 3, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-3", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "The structures shown below can form 2D and 3D COFs. For this question consider only formation of COFs", "bbox": [56.69300079345703, 130.40113830566406, 538.5801391601562, 196.35354614257812]}, {"text": "with boronate esters, imines, and C=C bonds through condensation reactions. A–E represent compound", "bbox": [56.6929931640625, 167.17449951171875, 538.5708618164062, 180.74172973632812]}, {"text": "classes with different functional groups.", "bbox": [56.6929931640625, 179.12950134277344, 243.57212829589844, 192.6967315673828]}, {"text": "Tetragonal means Tetragonal, Hexagonal means Hexagonal, Trigonal means Trigonal,", "bbox": [80.78900146484375, 660.7525024414062, 514.4866333007812, 674.3197021484375]}, {"text": "Kagome means Kagome, Tetrahedral means Tetrahedral.", "bbox": [80.78900146484375, 672.70751953125, 348.9776306152344, 686.2747192382812]}]}, {"page": 4, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-4", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "3.3", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Fill all the table cells with either new examples of monomer combinations that", "bbox": [114.69253540039062, 166.2294921875, 480.5756530761719, 179.79672241210938]}, {"text": "give the topologies shown above or with “XXX” if you are certain that no addi-", "bbox": [114.69100189208984, 178.18450927734375, 480.5756530761719, 191.75173950195312]}, {"text": "tional combinations satisfy that topology. Both the combinations and the “XXX”", "bbox": [114.69100952148438, 190.1405029296875, 480.5844421386719, 203.70773315429688]}, {"text": "entries will be graded. Incorrect answers (both combinations and “XXX” entries)", "bbox": [114.69100952148438, 202.0955047607422, 480.5827941894531, 215.66273498535156]}, {"text": "will be penalised. Blank table cells will not be graded.", "bbox": [114.69100952148438, 214.05050659179688, 363.2286682128906, 227.61773681640625]}, {"text": "Tetragonal", "bbox": [121.43299865722656, 264.4075012207031, 171.9315643310547, 277.9747314453125]}, {"text": "1", "bbox": [143.83099365234375, 276.3634948730469, 149.5273895263672, 289.93072509765625]}, {"text": "Tetragonal", "bbox": [185.01100158691406, 264.4075012207031, 235.50955200195312, 277.9747314453125]}, {"text": "2", "bbox": [207.41000366210938, 276.3634948730469, 213.1063995361328, 289.93072509765625]}, {"text": "Hexagonal", "bbox": [248.71800231933594, 264.4075012207031, 298.9575500488281, 277.9747314453125]}, {"text": "1", "bbox": [270.9880065917969, 276.3634948730469, 276.68438720703125, 289.93072509765625]}, {"text": "Hexagonal", "bbox": [312.2969970703125, 264.4075012207031, 362.5365295410156, 277.9747314453125]}, {"text": "2", "bbox": [334.5669860839844, 276.3634948730469, 340.26336669921875, 289.93072509765625]}, {"text": "Trigonal", "bbox": [379.4010009765625, 264.4075012207031, 417.8547668457031, 277.9747314453125]}, {"text": "Kagome", "bbox": [435.4630126953125, 264.4075012207031, 474.3068542480469, 277.9747314453125]}, {"text": "Tetra-", "bbox": [493.8760070800781, 258.43048095703125, 521.111572265625, 271.9977111816406]}, {"text": "hedral", "bbox": [491.1540222167969, 270.385498046875, 521.2392578125, 283.9527282714844]}, {"text": "A2 + B3", "bbox": [255.9199981689453, 292.3034973144531, 291.75323486328125, 305.8707275390625]}, {"text": "E1 + D2", "bbox": [319.80499267578125, 292.3034973144531, 355.0205383300781, 305.8707275390625]}, {"text": "C2 + D4", "bbox": [435.5989990234375, 292.3034973144531, 471.5816955566406, 305.8707275390625]}, {"text": "23.0 pt", "bbox": [495.1520080566406, 166.15451049804688, 526.921142578125, 179.72174072265625]}, {"text": "Whilst imine-based COFs are easily synthesised, they are also vulnerable to hydrolysis under strongly", "bbox": [56.69300079345703, 345.89715576171875, 538.5906982421875, 411.8495788574219]}, {"text": "acidic and basic conditions. The addition of hydroxy groups to the aldehyde or amine monomers can", "bbox": [56.69300079345703, 382.6705017089844, 538.5557250976562, 396.23773193359375]}, {"text": "overcome this. IR spectrum of COF-3 contained stretches corresponding to the imine functional group,", "bbox": [56.69300079345703, 394.6264953613281, 538.5673217773438, 408.1937255859375]}, {"text": "but COF-4 did not. COF-4 contains a different type of C=N bonds, and elemental analysis revealed a loss", "bbox": [56.6929931640625, 406.58148193359375, 538.5729370117188, 420.1487121582031]}, {"text": "of six additional hydrogen atoms per repeat unit relative to COF-3 as the only change. COF-5 irreversibly", "bbox": [56.69300079345703, 418.5364685058594, 538.5909423828125, 432.10369873046875]}, {"text": "isomerises to COF-6, which did not contain imine stretches in its IR spectrum.", "bbox": [56.693023681640625, 430.491455078125, 417.2680969238281, 444.0586853027344]}, {"text": "3.4", "bbox": [78.60800170898438, 627.2545166015625, 92.84233856201172, 640.8217163085938]}, {"text": "Draw the repeat units for COFs 3–6.", "bbox": [114.69253540039062, 627.2545166015625, 286.3433837890625, 640.8217163085938]}, {"text": "Indicate the edges of each repeat unit", "bbox": [296.44390869140625, 627.2545166015625, 480.5682373046875, 640.8217163085938]}, {"text": "with a dashed line as shown for COF-1 below.", "bbox": [114.69099426269531, 639.2095336914062, 326.3409729003906, 652.7767333984375]}, {"text": "12.0 pt", "bbox": [495.1520080566406, 627.1795043945312, 526.921142578125, 640.7467041015625]}]}, {"page": 5, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-5", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "Macrocycle X was synthesised by post-synthetic modification of COF-7 (C2 + D4) followed by degradation.", "bbox": [56.69300079345703, 155.21949768066406, 538.58203125, 168.78672790527344]}, {"text": "3.5", "bbox": [78.60800170898438, 320.0245056152344, 92.84233856201172, 333.59173583984375]}, {"text": "Draw the smallest repeat unit of macrocycle X.", "bbox": [114.69253540039062, 320.0245056152344, 333.7086181640625, 333.59173583984375]}, {"text": "6.0 pt", "bbox": [495.45001220703125, 319.9485168457031, 521.8194580078125, 333.5157470703125]}]}, {"page": 6, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-6", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "π-π interactions result in different stacking modes of COF layers, some of which are shown below.", "bbox": [56.69300079345703, 130.40113830566406, 514.740234375, 196.35354614257812]}, {"text": "Depending on stacking geometry, the interaction energy can be different as shown below.", "bbox": [56.69300079345703, 306.62548828125, 477.9223327636719, 320.1927185058594]}, {"text": "𝐸/ kJ mol−1", "bbox": [372.2040100097656, 325.0992126464844, 427.6797790527344, 361.1191101074219]}, {"text": "Interaction geometry", "bbox": [163.21701049804688, 365.4744873046875, 262.7908630371094, 379.0417175292969]}, {"text": "benzene (X = CH) – benzene (b-b)", "bbox": [136.4499969482422, 408.114501953125, 289.5433349609375, 421.6817321777344]}, {"text": "−7.9", "bbox": [347.9939880371094, 408.114501953125, 367.757568359375, 421.6817321777344]}, {"text": "−12.6", "bbox": [429.7799987792969, 408.114501953125, 455.2421875, 421.6817321777344]}, {"text": "benzene-triazine (X = N) (b-t)", "bbox": [146.7919921875, 424.05450439453125, 279.2229309082031, 437.6217346191406]}, {"text": "−49.8", "bbox": [345.14599609375, 424.05450439453125, 370.6081848144531, 437.6217346191406]}, {"text": "−55.6", "bbox": [429.7799987792969, 424.05450439453125, 455.2421875, 437.6217346191406]}, {"text": "triazine–triazine (t-t)", "bbox": [166.13600158691406, 439.9955139160156, 259.8721618652344, 453.562744140625]}, {"text": "−6.7", "bbox": [347.9939880371094, 439.9955139160156, 367.757568359375, 453.562744140625]}, {"text": "−16.7", "bbox": [429.7799987792969, 439.9955139160156, 455.2421875, 453.562744140625]}, {"text": "COF-8, synthesised from (E1 + D2), is notable for its remarkable stability. The AA' slightly shifted mode of", "bbox": [56.69300079345703, 473.8265075683594, 538.5752563476562, 487.39373779296875]}, {"text": "a COF-8 bilayer has a π-π stacking interaction energy of –67.1 kJ mol−1 between two layers of one repeat", "bbox": [56.693023681640625, 462.44415283203125, 538.5778198242188, 528.3965454101562]}, {"text": "unit.", "bbox": [56.693023681640625, 499.2174987792969, 77.84428405761719, 512.7847290039062]}, {"text": "3.6", "bbox": [78.60800170898438, 734.801513671875, 92.84233856201172, 748.3687133789062]}, {"text": "Calculate the π-π stacking energy between two layers of one repeat unit of", "bbox": [114.69253540039062, 734.801513671875, 480.5688171386719, 748.3687133789062]}, {"text": "COF-8, for the AA, AB and AB' arrangements. Assume π-π stacking happens", "bbox": [114.69100189208984, 746.7565307617188, 480.56341552734375, 760.32373046875]}, {"text": "only between aromatic units.", "bbox": [114.69097900390625, 758.7125244140625, 250.26271057128906, 772.2797241210938]}, {"text": "12.0 pt", "bbox": [495.1519775390625, 734.7265014648438, 526.921142578125, 748.293701171875]}]}, {"page": 7, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q3-7", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "COF-9, obtained from COF-8, absorbs UO2+", "bbox": [56.69300079345703, 130.48513793945312, 258.9551696777344, 196.4375457763672]}, {"text": "2", "bbox": [248.32998657226562, 148.01821899414062, 252.8131866455078, 179.14956665039062]}, {"text": "ions and loses its fluorescence. In an experiment, a suspen-", "bbox": [261.80096435546875, 155.30349731445312, 538.5697631835938, 168.8707275390625]}, {"text": "sion of 5.000 mg COF-9 in 19.90 mg dm−3 UO2+", "bbox": [56.69297790527344, 142.61614990234375, 281.3261413574219, 212.55455017089844]}, {"text": "2", "bbox": [270.7009582519531, 164.13421630859375, 275.18414306640625, 195.26556396484375]}, {"text": "solution (200.0 mL) was filtered after equilibrium was", "bbox": [285.16796875, 146.60214233398438, 538.5762329101562, 212.55455017089844]}, {"text": "reached. The final concentration of UO2+", "bbox": [56.69293212890625, 162.7181396484375, 249.09609985351562, 228.67054748535156]}, {"text": "2", "bbox": [238.47091674804688, 180.25021362304688, 242.95411682128906, 211.38156127929688]}, {"text": "was 9.225 mg dm−3.", "bbox": [252.18191528320312, 162.7181396484375, 344.5075378417969, 228.67054748535156]}, {"text": "3.7", "bbox": [78.60800170898438, 497.13848876953125, 92.84233856201172, 510.7057189941406]}, {"text": "Calculate the equilibrium absorption capacity at a given temperature (𝑞𝑒) in", "bbox": [114.69253540039062, 482.22296142578125, 480.58245849609375, 518.4015502929688]}, {"text": "mg g−1 of COF-9.", "bbox": [114.69097900390625, 487.11517333984375, 199.38461303710938, 553.0675659179688]}, {"text": "Indicate the number of UO2+", "bbox": [209.7019805908203, 487.11517333984375, 356.2142028808594, 553.0675659179688]}, {"text": "2", "bbox": [345.5889892578125, 504.2812194824219, 350.07220458984375, 535.4125366210938]}, {"text": "ions absorbed per pore.", "bbox": [361.5889892578125, 511.93353271484375, 480.572998046875, 525.500732421875]}, {"text": "Assume that all uranium exists as UO2+", "bbox": [114.69099426269531, 503.23211669921875, 301.55120849609375, 569.1845092773438]}, {"text": "2", "bbox": [290.926025390625, 520.397216796875, 295.40924072265625, 551.528564453125]}, {"text": "ions.", "bbox": [304.63800048828125, 528.0504760742188, 326.8353576660156, 541.61767578125]}, {"text": "5.0 pt", "bbox": [495.45001220703125, 497.0635070800781, 521.8194580078125, 510.6307373046875]}]}]