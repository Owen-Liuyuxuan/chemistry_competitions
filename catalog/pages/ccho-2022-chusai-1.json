234375, 699.8629760742188, 460.0611877441406, 728.4429931640625]}, {"text": "TMSOTf", "bbox": [294.74578857421875, 681.329345703125, 334.7157897949219, 709.9093627929688]}, {"text": ". M LiClO", "bbox": [288.0921325683594, 702.7237548828125, 348.81964111328125, 731.5413208007812]}, {"text": " min, − °C", "bbox": [286.84588623046875, 717.0938110351562, 350.0658874511719, 745.673828125]}]}, {"page": 5, "width": 595.2755126953125, "height": 841.8897705078125, "mode": "native", "lines": [{"text": "5", "bbox": [294.7256774902344, 766.9943237304688, 303.6899108886719, 798.546630859375]}, {"text": "9-1", "bbox": [72.24569702148438, 67.69097137451172, 89.14599609375, 96.4996109008789]}, {"text": "利⽤上述⽅法，可以进⾏分⼦内[5+2]环加成反应构建三环体系，画出以下反应产物的结构简式：", "bbox": [98.64559936523438, 67.69097137451172, 525.0654907226562, 96.4996109008789]}, {"text": "9-2", "bbox": [72.24569702148438, 154.33096313476562, 90.42603302001953, 183.1396026611328]}, {"text": "苯酚衍⽣物在四醋酸铅作⽤下氧化去芳构化，继⽽发⽣正离⼦[5+2]环加成反应，画出形成环加成", "bbox": [98.64559936523438, 154.33096313476562, 522.5693359375, 183.1396026611328]}, {"text": "产物的关键中间体。", "bbox": [72.24569702148438, 173.05096435546875, 164.826171875, 201.85960388183594]}, {"text": "9-3", "bbox": [72.24569702148438, 273.6109924316406, 90.41602325439453, 302.41961669921875]}, {"text": "将9-2 中的环加成和重排反应相结合，应⽤于四环⼆萜天然产物的合成，其模型反应如下所⽰，", "bbox": [98.64559936523438, 273.6109924316406, 519.3394775390625, 302.41961669921875]}, {"text": "画出此转换的关键中间体。", "bbox": [72.24569702148438, 292.3309631347656, 194.826171875, 321.13958740234375]}, {"text": "9-4", "bbox": [72.24569702148438, 383.0509948730469, 90.41602325439453, 411.859619140625]}, {"text": "当底物含环丙基⼄烯基时，不论是在硝基甲烷还是在六氟异丙醇(HFIP)溶剂中反应均得到螺环产", "bbox": [98.64559936523438, 383.0509948730469, 521.288330078125, 411.859619140625]}, {"text": "物，画出此转换的关键中间体。", "bbox": [72.24569702148438, 401.7709655761719, 214.82615661621094, 430.57958984375]}, {"text": "第10 题（11 分）⼗氢合萘化学", "bbox": [72.24569702148438, 506.4109802246094, 212.23583984375, 535.2196044921875]}, {"text": "在萜类天然产物中，氧化态升⾼与抗癌、抗病毒和免疫抑制的⽣物活性提⾼密切相关。以下反应发展了", "bbox": [72.24569702148438, 525.1309814453125, 522.342041015625, 553.9396362304688]}, {"text": "并环构建萜类化合物的⽅法（TBS 为叔丁基⼆甲基硅基，#Pr 为异丙基）：", "bbox": [72.24569702148438, 543.8509521484375, 402.9241638183594, 572.6596069335938]}, {"text": "10-1 在环⼰烷椅式构象中，CH3—H 之间1,3-直⽴键的相互作⽤⼒和丁烷邻交叉作⽤⼒相当，在298", "bbox": [72.24569702148438, 626.6509399414062, 518.7279663085938, 655.4595947265625]}, {"text": "K 下，假定丁烷的对交叉构象能量为0 kJ mol−1，邻交叉构象能量约为3.8 kJ mol−1，重叠构象能量约", "bbox": [72.24569702148438, 645.1309814453125, 518.2373046875, 673.9396362304688]}, {"text": "为21.4 kJ mol−1。", "bbox": [72.24569702148438, 663.8509521484375, 156.990478515625, 692.6596069335938]}, {"text": "10-1-1 计算顺式⼗氢合萘与反式⼗氢合萘的能量差。", "bbox": [72.24569702148438, 682.5709228515625, 307.1358642578125, 711.3795776367188]}, {"text": "10-1-2 计算顺式9-甲基⼗氢合萘与反式9-甲基⼗氢合萘的能量差。", "bbox": [72.24569702148438, 701.2909545898438, 371.5753479003906, 730.099609375]}, {"text": "10-2 画出产物A 的结构简式（不要求⽴体化学）。写出A 可能的⽴体异构体的数⽬。", "bbox": [72.24569702148438, 720.0109252929688, 456.1460876464844, 748.819580078125]}, {"text": "10-3 画出上述转换的关键中间体（不要求⽴体化学）。", "bbox": [72.24569702148438, 738.73095703125, 321.22601318359375, 767.5396118164062]}, {"text": "O", "bbox": [214.67160034179688, 137.98854064941406, 222.3415985107422, 166.56854248046875]}, {"text": "OMe", "bbox": [239.6916046142578, 94.78858947753906, 262.1615905761719, 123.36858367919922]}, {"text": "MeO OMe", "bbox": [192.5115966796875, 82.31855773925781, 244.41160583496094, 110.89855194091797]}, {"text": "？", "bbox": [398.07049560546875, 105.91397094726562, 408.07049560546875, 134.4939727783203]}, {"text": "TMSOTf", "bbox": [324.7379150390625, 95.76736450195312, 364.7079162597656, 124.34736633300781]}, {"text": ". M LiClO", "bbox": [318.0842590332031, 117.16191101074219, 378.811767578125, 145.97940063476562]}, {"text": " min, − °C", "bbox": [316.8380126953125, 131.5319366455078, 380.0580139160156, 160.1119384765625]