[{"page": 1, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q7-1", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "T7. Nitrogen Fixation", "bbox": [56.69300079345703, 150.9783477783203, 225.4873809814453, 172.68597412109375]}, {"text": "7%", "bbox": [290.6499938964844, 193.6215057373047, 304.6280822753906, 207.18873596191406]}, {"text": "7.1", "bbox": [172.68299865722656, 209.5625, 186.7479705810547, 223.12973022460938]}, {"text": "7.2", "bbox": [204.3090057373047, 209.5625, 218.37399291992188, 223.12973022460938]}, {"text": "7.3", "bbox": [235.93499755859375, 209.5625, 249.99998474121094, 223.12973022460938]}, {"text": "7.4", "bbox": [267.5610046386719, 209.5625, 281.6259765625, 223.12973022460938]}, {"text": "7.5", "bbox": [299.18701171875, 209.5625, 313.2519836425781, 223.12973022460938]}, {"text": "7.6", "bbox": [330.81298828125, 209.5625, 344.8779602050781, 223.12973022460938]}, {"text": "7.7", "bbox": [362.4389953613281, 209.5625, 376.50396728515625, 223.12973022460938]}, {"text": "∑", "bbox": [403.7760009765625, 194.6659698486328, 412.8818054199219, 229.256103515625]}, {"text": "3", "bbox": [176.86700439453125, 225.50250244140625, 182.5634002685547, 239.06973266601562]}, {"text": "8", "bbox": [208.4929962158203, 225.50250244140625, 214.18939208984375, 239.06973266601562]}, {"text": "15", "bbox": [237.27099609375, 225.50250244140625, 248.66600036621094, 239.06973266601562]}, {"text": "3", "bbox": [271.7449951171875, 225.50250244140625, 277.4413757324219, 239.06973266601562]}, {"text": "6", "bbox": [303.3710021972656, 225.50250244140625, 309.0673828125, 239.06973266601562]}, {"text": "6", "bbox": [334.99700927734375, 225.50250244140625, 340.6933898925781, 239.06973266601562]}, {"text": "13", "bbox": [363.7749938964844, 225.50250244140625, 375.16998291015625, 239.06973266601562]}, {"text": "54", "bbox": [402.6319885253906, 225.50250244140625, 414.0269775390625, 239.06973266601562]}, {"text": "The Haber–Bosch process is the principal industrial method for ammonia production. A simplified dia-", "bbox": [56.69300079345703, 259.33349609375, 538.5518798828125, 272.9007263183594]}, {"text": "gram of an ammonia synthesis plant is shown below.", "bbox": [56.69300079345703, 271.28851318359375, 304.493408203125, 284.8557434082031]}, {"text": "Fig. 1. M1 - Mixture 1, M2 - Mixture 2, Z −CO2 scrubber, CLR - cooler", "bbox": [136.58099365234375, 491.969970703125, 458.6917419433594, 526.5601196289062]}, {"text": "In the following calculations, assume that all reactions in Fig. 1, except NH3 formation, are quantitative.", "bbox": [56.693023681640625, 526.8085327148438, 538.575439453125, 542.86669921875]}]}, {"page": 2, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q7-2", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "7.1", "bbox": [78.60800170898438, 166.17649841308594, 92.84233856201172, 179.7437286376953]}, {"text": "Tick the gases contained in M1 and M2; and tick the correct relationship be-", "bbox": [114.69253540039062, 166.17649841308594, 480.58184814453125, 179.7437286376953]}, {"text": "tween 𝑥and 𝑦.", "bbox": [114.69099426269531, 163.21597290039062, 182.2466278076172, 197.80612182617188]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 190.0865020751953, 169.74588012695312, 203.6537322998047]}, {"text": "CH4", "bbox": [183.2239990234375, 216.66549682617188, 202.02978515625, 232.43087768554688]}, {