[{"page": 1, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-1", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "T8. Recycling of Carbon Dioxide", "bbox": [56.69300079345703, 151.06434631347656, 306.6484069824219, 172.77197265625]}, {"text": "7%", "bbox": [290.6499938964844, 193.70750427246094, 304.6280822753906, 207.2747344970703]}, {"text": "8.1", "bbox": [127.6520004272461, 209.6475067138672, 141.71697998046875, 223.21473693847656]}, {"text": "8.2", "bbox": [159.2779998779297, 209.6475067138672, 173.3429718017578, 223.21473693847656]}, {"text": "8.3", "bbox": [190.90399169921875, 209.6475067138672, 204.96897888183594, 223.21473693847656]}, {"text": "8.4", "bbox": [222.52999877929688, 209.6475067138672, 236.59498596191406, 223.21473693847656]}, {"text": "8.5", "bbox": [254.156005859375, 209.6475067138672, 268.2209777832031, 223.21473693847656]}, {"text": "8.6", "bbox": [285.781982421875, 209.6475067138672, 299.8469543457031, 223.21473693847656]}, {"text": "8.7", "bbox": [317.40802001953125, 209.6475067138672, 331.4729919433594, 223.21473693847656]}, {"text": "8.8", "bbox": [349.0350036621094, 209.6475067138672, 363.0999755859375, 223.21473693847656]}, {"text": "8.9", "bbox": [380.6610107421875, 209.6475067138672, 394.7259826660156, 223.21473693847656]}, {"text": "8.10", "bbox": [411.8500061035156, 209.6475067138672, 431.61358642578125, 223.21473693847656]}, {"text": "∑", "bbox": [453.62701416015625, 194.75196838378906, 462.7328186035156, 229.34210205078125]}, {"text": "2", "bbox": [131.83599853515625, 225.5885009765625, 137.5323944091797, 239.15573120117188]}, {"text": "16", "bbox": [160.61399841308594, 225.5885009765625, 172.00900268554688, 239.15573120117188]}, {"text": "2", "bbox": [195.08799743652344, 225.5885009765625, 200.78439331054688, 239.15573120117188]}, {"text": "29", "bbox": [223.86599731445312, 225.5885009765625, 235.26100158691406, 239.15573120117188]}, {"text": "5", "bbox": [258.3399963378906, 225.5885009765625, 264.036376953125, 239.15573120117188]}, {"text": "10", "bbox": [287.11798095703125, 225.5885009765625, 298.5129699707031, 239.15573120117188]}, {"text": "2", "bbox": [321.59197998046875, 225.5885009765625, 327.2883605957031, 239.15573120117188]}, {"text": "4", "bbox": [353.2179870605469, 225.5885009765625, 358.91436767578125, 239.15573120117188]}, {"text": "12", "bbox": [381.9960021972656, 225.5885009765625, 393.3909912109375, 239.15573120117188]}, {"text": "2", "bbox": [418.8819885253906, 225.5885009765625, 424.578369140625, 239.15573120117188]}, {"text": "84", "bbox": [452.4830017089844, 225.5885009765625, 463.87799072265625, 239.15573120117188]}, {"text": "Removing CO2 gas from the atmosphere is key to combat climate change. One promising solution is the", "bbox": [56.69300079345703, 259.41851806640625, 538.571533203125, 275.4767150878906]}, {"text": "photocatalytic reduction of CO2 to CO using molecular catalyst 1.", "bbox": [56.6930046081543, 271.37451171875, 360.442626953125, 287.4327087402344]}, {"text": "8.1", "bbox": [78.60800170898438, 373.83551025390625, 92.84233856201172, 387.4027404785156]}, {"text": "Write the half equation for the reduction of CO2 to CO in an acidic medium.", "bbox": [114.69253540039062, 373.83551025390625, 468.75927734375, 389.89373779296875]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 385.7904968261719, 169.74588012695312, 399.35772705078125]}, {"text": "CO2 + 2H+ + 2𝑒−→CO + H2O", "bbox": [114.69100189208984, 372.9281311035156, 253.430908203125, 438.88055419921875]}, {"text": "2 points for a fully correct reaction equation.", "bbox": [114.69100952148438, 409.70147705078125, 322.5215148925781, 423.2687072753906]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 373.760498046875, 521.8194580078125, 387.3277282714844]}, {"text": "The conjugate oxidation reaction occurs with sacrificial reductant 2 in aqueous solution with the following", "bbox": [56.69300079345703, 439.3924865722656, 538.5880737304688, 452.959716796875]}, {"text": "mechanism:", "bbox": [56.693023681640625, 451.34747314453125, 113.63990783691406, 464.9147033691406]}, {"text": "Species 3, 4, and 5 are short-lived ionic and/or radical intermediates. 7 yields a silver mirror with the", "bbox": [56.69300079345703, 558.2675170898438, 538.5806884765625, 571.834716796875]}, {"text": "[Ag(NH3)2]OH test.", "bbox": [56.6929931640625, 555.3069458007812, 146.66201782226562, 589.8970947265625]}]}, {"page": 2, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-2", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "8.2", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Draw the structures of 3-7.", "bbox": [114.69253540039062, 166.2294921875, 241.50062561035156, 179.79672241210938]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 178.18450927734375, 169.74588012695312, 191.75173950195312]}, {"text": "Both resonance structures 5.1 and 5.2 are correct answers.", "bbox": [114.69100189208984, 190.1405029296875, 390.01153564453125, 203.70773315429688]}, {"text": "4 points for each correctly drawn structure of 3, 4, and 5.1 or 5.2.", "bbox": [114.69100189208984, 587.3464965820312, 418.0745849609375, 600.9136962890625]}, {"text": "2 points for each correctly drawn structure of 6 and 7.", "bbox": [114.69094848632812, 599.301513671875, 366.1895446777344, 612.8687133789062]}, {"text": "Half of the marks will be given for the alternative reasonable structures, as", "bbox": [114.69091796875, 611.2575073242188, 480.5674743652344, 624.82470703125]}, {"text": "shown above.", "bbox": [114.69091796875, 623.2125244140625, 179.1296844482422, 636.7797241210938]}, {"text": "16.0 pt", "bbox": [495.1520080566406, 166.15451049804688, 526.921142578125, 179.72174072265625]}, {"text": "Catalyst 1 can be synthesised with the following reaction.", "bbox": [56.69300079345703, 650.6505126953125, 323.4672546386719, 664.2177124023438]}]}, {"page": 3, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-3", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "8.3", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Tick the correct geometry for the structure of 1.", "bbox": [114.69253540039062, 166.2294921875, 339.3226013183594, 179.79672241210938]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 178.18450927734375, 169.74588012695312, 191.75173950195312]}, {"text": "The pyridine donor groups are planar in ligand 8, thus, the final configuration", "bbox": [114.69100189208984, 190.1405029296875, 480.57989501953125, 203.70773315429688]}, {"text": "of ligand 8 should also be in one plane around the metal in complex 1.", "bbox": [114.69102478027344, 202.0955047607422, 443.1806640625, 215.66273498535156]}, {"text": "There is only one option that corresponds to this complex.", "bbox": [114.69100189208984, 284.781494140625, 386.90972900390625, 298.3487243652344]}, {"text": "2 points for the only correct answer.", "bbox": [114.69100189208984, 464.24951171875, 283.6274719238281, 477.8167419433594]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 166.15451049804688, 521.8194580078125, 179.72174072265625]}]}, {"page": 4, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-4", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "When 1 is loaded on crystalline carbon nitride (C3N4) support material, it can reduce CO2 via the following", "bbox": [56.69300079345703, 155.21949768066406, 538.5894165039062, 171.27772521972656]}, {"text": "mechanism.", "bbox": [56.6929931640625, 167.17449951171875, 113.63987731933594, 180.74172973632812]}]}, {"page": 5, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-5", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "8.4", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Draw the structures of 9-15. Use the cartoon structure for ligand 8 shown", "bbox": [114.69253540039062, 166.2294921875, 480.58880615234375, 179.79672241210938]}, {"text": "above. For 9-15, specify the oxidation state, 𝑂𝑆, coordination number, 𝐶𝑁,", "bbox": [114.69100952148438, 163.26898193359375, 480.5846252441406, 197.859130859375]}, {"text": "and number of valence electrons, 𝑉𝐸, of Fe, along with the total charge of cor-", "bbox": [114.69100952148438, 177.5689697265625, 480.5687255859375, 212.15911865234375]}, {"text": "responding complex structures, 𝑍. Note: Some information is provided on the", "bbox": [114.69100952148438, 189.5239715576172, 480.5813903808594, 224.11410522460938]}, {"text": "answer sheet.", "bbox": [114.69100952148438, 216.39450073242188, 179.78729248046875, 229.96173095703125]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 228.35049438476562, 169.74588012695312, 241.917724609375]}, {"text": "The catalytic cycle is presented below. In this part of the task, the arrangement", "bbox": [114.69100189208984, 240.3054962158203, 480.58587646484375, 253.8727264404297]}, {"text": "of ligand 8 is not graded as long as it corresponds to the one around the metal", "bbox": [114.69100189208984, 252.260498046875, 480.5618591308594, 265.8277282714844]}, {"text": "complex in the previous part of the task (to avoid double punishment).", "bbox": [114.69100189208984, 264.21551513671875, 443.5570373535156, 277.7827453613281]}, {"text": "For each correct OS, CN, and VE: 0.5 points.", "bbox": [114.69100189208984, 581.6304931640625, 316.2948303222656, 595.1976928710938]}, {"text": "For each correctly drawn structure of 9-15: 3 points.", "bbox": [114.69100189208984, 593.5855102539062, 357.312744140625, 607.1527099609375]}, {"text": "–0.5 points for each structure (9–15) in which the total charge is not correct.", "bbox": [114.69100952148438, 605.54052734375, 467.2628479003906, 619.1077270507812]}, {"text": "29.0 pt", "bbox": [495.1520080566406, 166.15451049804688, 526.921142578125, 179.72174072265625]}, {"text": "￿", "bbox": [56.69300079345703, 635.2315063476562, 62.671531677246094, 648.7987060546875]}]}, {"page": 6, "width": 595.280029296875, "height": 841.8900146484375, "mode": "ocr", "lines": [{"text": "Theory", "bbox": [57.0, 67.5, 105.5, 84.0]}, {"text": "人 ChaO", "bbox": [57.0, 83.0, 131.0, 110.5]}, {"text": "58th International", "bbox": [57.0, 114.0, 130.5, 120.5]}, {"text": "Chemistry Olympiad", "bbox": [52.0, 121.0, 130.5, 134.0]}, {"text": "Uzbekistan 2026", "bbox": [56.5, 132.0, 131.0, 139.5]}, {"text": "English (Official)", "bbox": [462.0, 132.0, 535.5, 142.0]}, {"text": "OS =+1 CN=5", "bbox": [302.0, 231.5, 366.0, 245.5]}, {"text": "E=17 Z=+1", "bbox": [309.0, 245.0, 365.5, 252.0]}, {"text": "OS =+2 CN=5", "bbox": [302.0, 338.0, 366.0, 351.0]}, {"text": "VE=16 Z=+1", "bbox": [302.5, 351.0, 365.0, 358.0]}, {"text": "Os", "bbox": [302.0, 453.5, 312.5, 460.0]}, {"text": "OS=+2 CN=5", "bbox": [134.0, 558.5, 198.0, 565.5]}, {"text": "VE=16 Z=+2", "bbox": [134.0, 569.5, 198.5, 576.5]}]}, {"page": 7, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-7", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "8.5", "bbox": [78.60800170898438, 169.08551025390625, 92.84233856201172, 182.65274047851562]}, {"text": "Calculate the number of catalytic molecules per nm2, 𝑁𝑐𝑎𝑡, of C3N4 loaded with", "bbox": [114.69253540039062, 154.16998291015625, 480.5807800292969, 190.34857177734375]}, {"text": "1, when the mass fraction of catalyst, 𝜔𝑐𝑎𝑡= 3.8%, if the specific surface area of", "bbox": [114.69100952148438, 166.12496948242188, 480.5807800292969, 202.30355834960938]}, {"text": "C3N4", "bbox": [114.69100952148438, 195.10450744628906, 142.3929443359375, 210.87088012695312]}, {"text": "is 17.8 m2 g−1. M𝑐𝑎𝑡= 557.21 g mol−1.", "bbox": [139.81497192382812, 178.75921630859375, 321.3186340332031, 216.3675537109375]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 207.0594940185547, 169.74588012695312, 220.62672424316406]}, {"text": "In 1 nm2 there is", "bbox": [114.69100189208984, 202.6702117919922, 202.0084991455078, 233.8015594482422]}, {"text": "1", "bbox": [225.21400451660156, 201.8732147216797, 229.69720458984375, 233.0045623779297]}, {"text": "17.8×1018", "bbox": [208.0229949951172, 212.93922424316406, 246.3890838623047, 244.07057189941406]}, {"text": "= 5.618 × 10−20 g C3N4. The catalytic loading", "bbox": [255.62498474121094, 194.19615173339844, 480.5838623046875, 260.1485595703125]}, {"text": "formula is", "bbox": [114.69097900390625, 236.20350646972656, 163.55758666992188, 249.77073669433594]}, {"text": "𝑚cat", "bbox": [186.13796997070312, 218.11322021484375, 203.6777801513672, 249.24456787109375]}, {"text": "𝑚cat+𝑚𝐶3𝑁4", "bbox": [169.08700561523438, 228.62721252441406, 220.23104858398438, 263.2969055175781]}, {"text": "× 100% = 3.8%.", "bbox": [226.125, 221.28797912597656, 300.9576110839844, 255.87811279296875]}, {"text": "If we find 𝑚cat from here it will be", "bbox": [309.62445068359375, 221.28797912597656, 480.5741271972656, 255.87811279296875]}, {"text": "𝑚cat = 2.219 × 10−21 g.", "bbox": [114.69100952148438, 240.23822021484375, 217.3666534423828, 278.74810791015625]}, {"text": "The molar mass of catalyst is 557.21 g mol−1 →𝑁= 2.219×10−21", "bbox": [114.6910171508789, 255.01397705078125, 401.1256408691406, 293.589111328125]}, {"text": "557.21", "bbox": [364.8919982910156, 266.3382263183594, 389.54962158203125, 297.4695739746094]}, {"text": "×6.02×1023 = 2.4.", "bbox": [402.9859924316406, 255.01397705078125, 480.5845947265625, 293.589111328125]}, {"text": "3 points for using the specific surface area of 17.8 m2g−1 for the 𝐶3𝑁4/1 mixture", "bbox": [114.69097900390625, 281.4801940917969, 480.5943908691406, 319.0875549316406]}, {"text": "and, calculating 𝑁cat as 2.3.", "bbox": [114.69094848632812, 294.8649597167969, 244.71719360351562, 329.4551086425781]}, {"text": "5 points for the correct 𝑁𝑐𝑎𝑡value.", "bbox": [114.69094848632812, 306.8199462890625, 275.1677551269531, 342.99853515625]}, {"text": "5.0 pt", "bbox": [495.45001220703125, 169.00949096679688, 521.8194580078125, 182.57672119140625]}, {"text": "The Turnover Frequency of a catalyst (TOF) is the number of product molecules formed per active catalyst", "bbox": [56.69300079345703, 351.62249755859375, 538.5624389648438, 365.1897277832031]}, {"text": "molecule per hour. Under LED illumination (𝜆= 390 nm) with power of 50 mW, there was a TOF of 8 h−1", "bbox": [56.69300079345703, 349.05322265625, 538.0847778320312, 385.0731201171875]}, {"text": "for 10 mg of C3N4, loaded with 1 with 𝜔𝑐𝑎𝑡= 3.8%", "bbox": [56.692962646484375, 362.43798828125, 287.4955749511719, 398.6165771484375]}, {"text": "The formula for calculating the quantum yield is given below:", "bbox": [56.69297790527344, 395.2865295410156, 342.6302490234375, 408.853759765625]}, {"text": "𝜑= 𝑛𝑢𝑚𝑏𝑒𝑟𝑜𝑓𝑟𝑒𝑎𝑐𝑡𝑒𝑑𝑒𝑙𝑒𝑐𝑡𝑟𝑜𝑛𝑠", "bbox": [218.39599609375, 412.45721435546875, 346.0124206542969, 449.5791320800781]}, {"text": "𝑛𝑢𝑚𝑏𝑒𝑟𝑜𝑓𝑖𝑛𝑐𝑖𝑑𝑒𝑛𝑡𝑝ℎ𝑜𝑡𝑜𝑛𝑠⋅100%", "bbox": [240.0030059814453, 414.9889831542969, 376.8769226074219, 453.4595642089844]}, {"text": "8.6", "bbox": [78.60800170898438, 468.5205078125, 92.84233856201172, 482.0877380371094]}, {"text": "Calculate the quantum yield, 𝜑(%), for CO formation.", "bbox": [114.69254302978516, 453.60498046875, 362.6832580566406, 488.19512939453125]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 480.47650146484375, 169.74588012695312, 494.0437316894531]}, {"text": "𝑚1,cat", "bbox": [126.8030014038086, 473.29522705078125, 150.31980895996094, 505.7649230957031]}, {"text": "𝑚1,cat+0.01 × 100% = 3.8% →𝑚cat = 3.95 × 10−4 g.", "bbox": [115.88700103759766, 476.0862121582031, 336.3476257324219, 517.3248901367188]}, {"text": "𝑛= 3.95×10−4", "bbox": [114.69099426269531, 497.1606750488281, 173.03855895996094, 535.007080078125]}, {"text": "557.21", "bbox": [141.03799438476562, 507.7562561035156, 165.6956024169922, 538.8875732421875]}, {"text": "= 7.089 × 10−7 mol.", "bbox": [177.5, 498.9882507324219, 264.5693664550781, 535.0071411132812]}, {"text": "𝑟CO = 7.089×10−7×8×6.02×1023", "bbox": [114.69099426269531, 516.8226928710938, 244.62307739257812, 557.1861572265625]}, {"text": "3600", "bbox": [186.33200073242188, 527.418212890625, 204.26480102539062, 558.549560546875]}, {"text": "= 9.48 × 1014 s−1", "bbox": [249.08499145507812, 518.6502685546875, 324.32818603515625, 554.6691284179688]}, {"text": "𝐸𝑝ℎ𝑜𝑡𝑜𝑛= ℎ𝑐", "bbox": [114.69099426269531, 534.6641845703125, 169.7866668701172, 573.0685424804688]}, {"text": "𝜆= 5.1 × 10−19 J", "bbox": [163.13800048828125, 535.461181640625, 237.9242706298828, 575.3605346679688]}, {"text": "𝑟𝑝ℎ𝑜𝑡𝑜𝑛= 50×10−3", "bbox": [114.69098663330078, 553.312744140625, 194.07254028320312, 592.74853515625]}, {"text": "5.1×10−19 = 9.8 × 1016 s−1", "bbox": [157.84300231933594, 555.1402587890625, 271.9091796875, 596.54052734375]}, {"text": "𝜑= 𝑛𝑢𝑚𝑏𝑒𝑟𝑜𝑓𝑟𝑒𝑎𝑐𝑡𝑒𝑑𝑒𝑙𝑒𝑐𝑡𝑟𝑜𝑛𝑒𝑠", "bbox": [114.69099426269531, 573.3521728515625, 246.29750061035156, 610.47412109375]}, {"text": "𝑛𝑢𝑚𝑏𝑒𝑟𝑜𝑓𝑖𝑛𝑐𝑖𝑑𝑒𝑛𝑡𝑝ℎ𝑜𝑡𝑜𝑛𝑠⋅100% = 𝑟𝐶𝑂⋅2", "bbox": [138.29299926757812, 572.691162109375, 315.515625, 614.353515625]}, {"text": "𝑟𝑝ℎ𝑜𝑡𝑜𝑛⋅100%", "bbox": [290.7200012207031, 575.8839721679688, 347.9849548339844, 615.69287109375]}, {"text": "(eq.8.6.1)", "bbox": [357.94757080078125, 565.9811401367188, 396.9637451171875, 631.9335327148438]}, {"text": "𝜑= 9.48×1014×2", "bbox": [114.69100952148438, 595.86376953125, 183.9676971435547, 633.7101440429688]}, {"text": "9.8×1016", "bbox": [142.2340087890625, 608.023193359375, 176.11709594726562, 639.154541015625]}, {"text": "⋅100% = 1.94%", "bbox": [187.3769989013672, 599.1199951171875, 252.05418395996094, 633.7101440429688]}, {"text": "2 points for 𝑟CO value.", "bbox": [114.69100189208984, 619.1656494140625, 219.2418212890625, 678.5232543945312]}, {"text": "2 point for 𝐸𝑝ℎ𝑜𝑡𝑜𝑛value.", "bbox": [114.69099426269531, 634.9860229492188, 229.10281372070312, 671.1646118164062]}, {"text": "2 point for the correct photon flux 𝑟𝑝ℎ𝑜𝑡𝑜𝑛.", "bbox": [114.69098663330078, 646.9410400390625, 308.6526184082031, 683.11962890625]}, {"text": "2 points for eq.8.6.1.", "bbox": [114.69097900390625, 673.8115844726562, 210.4920196533203, 687.3787841796875]}, {"text": "2 point for the correct 𝜑value.", "bbox": [114.69097900390625, 670.85107421875, 256.5777893066406, 705.4412231445312]}, {"text": "10.0 pt", "bbox": [495.1520080566406, 468.44549560546875, 526.921142578125, 482.0127258300781]}]}, {"page": 8, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-8", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "The diagram below shows the change in the TOF of CO as 𝜔𝑐𝑎𝑡is varied.", "bbox": [56.69300079345703, 140.30397033691406, 391.1622009277344, 176.48255920410156]}, {"text": "8.7", "bbox": [78.60800170898438, 407.23748779296875, 92.84233856201172, 420.8047180175781]}, {"text": "How does the overall rate of CO formation per gram of C3N4 loaded with 1", "bbox": [114.69253540039062, 407.23748779296875, 480.5843811035156, 423.29571533203125]}, {"text": "change with increasing 𝜔𝑐𝑎𝑡, within the range 0.1 ≤𝜔𝑐𝑎𝑡≤2.9? Tick the correct", "bbox": [114.69100952148438, 404.2769470214844, 480.583984375, 440.4555358886719]}, {"text": "box.", "bbox": [114.69097900390625, 431.1474914550781, 134.69654846191406, 444.7147216796875]}, {"text": "a) increases", "bbox": [137.36798095703125, 443.10247802734375, 189.7725372314453, 456.6697082519531]}, {"text": "b) decreases", "bbox": [137.36798095703125, 455.0584716796875, 192.2831268310547, 468.6257019042969]}, {"text": "c) doesn't change", "bbox": [137.36798095703125, 467.0134582519531, 214.2595672607422, 480.5806884765625]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 478.968505859375, 169.74588012695312, 492.5357360839844]}, {"text": "a", "bbox": [209.31199645996094, 505.5465087890625, 214.9013671875, 519.1137084960938]}, {"text": "b", "bbox": [294.572998046875, 505.5465087890625, 300.70233154296875, 519.1137084960938]}, {"text": "c", "bbox": [380.77801513671875, 505.5465087890625, 385.55987548828125, 519.1137084960938]}, {"text": "×", "bbox": [208.91900634765625, 506.57196044921875, 215.29507446289062, 541.162109375]}, {"text": "2 point for the only correct ticking", "bbox": [114.69100189208984, 549.3405151367188, 273.22821044921875, 562.90771484375]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 407.1614990234375, 521.8194580078125, 420.7287292480469]}, {"text": "The reduction of CO2 can be accompanied by the reduction of additional protons. The changes in Gibbs", "bbox": [56.69300079345703, 579.031494140625, 538.5443725585938, 595.0897216796875]}, {"text": "energy during these two reactions are shown in the diagram.", "bbox": [56.69300842285156, 590.9865112304688, 342.4309997558594, 604.5537109375]}]}, {"page": 9, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-9", "bbox": [410.3869934082031, 59.77293014526367, 538.61376953125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8269958496094, 128.718505859375, 535.9927978515625, 142.28573608398438]}, {"text": "The system was irradiated using different LEDs. The diagram below shows the mole percentages, 𝜒, of", "bbox": [56.69300079345703, 431.3599853515625, 538.5763549804688, 465.95013427734375]}, {"text": "H2 and CO produced during the reduction of CO2 under four different conditions: no irradiation (N) and", "bbox": [56.6929931640625, 458.2304992675781, 538.5681762695312, 474.2887268066406]}, {"text": "irradiation with red (R), green (G), and blue (B) light.", "bbox": [56.6929931640625, 470.1864929199219, 297.5993347167969, 483.75372314453125]}]}, {"page": 10, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-10", "bbox": [377.97100830078125, 59.77293014526367, 538.6260986328125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8270263671875, 128.718505859375, 535.992919921875, 142.28573608398438]}, {"text": "8.8", "bbox": [78.60800170898438, 502.88153076171875, 92.84233856201172, 516.44873046875]}, {"text": "Tick which of the four conditions, mentioned above, corresponds to a, b, c and", "bbox": [114.69253540039062, 502.88153076171875, 480.5822448730469, 516.44873046875]}, {"text": "d in the diagram.", "bbox": [114.69100952148438, 514.8364868164062, 194.86708068847656, 528.4036865234375]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 526.79150390625, 169.74588012695312, 540.3587036132812]}, {"text": "N", "bbox": [244.9080047607422, 553.3705444335938, 252.4772491455078, 566.937744140625]}, {"text": "R", "bbox": [294.53900146484375, 553.3705444335938, 300.7364501953125, 566.937744140625]}, {"text": "G", "bbox": [342.9570007324219, 553.3705444335938, 350.2100524902344, 566.937744140625]}, {"text": "B", "bbox": [392.2909851074219, 553.3705444335938, 398.7657165527344, 566.937744140625]}, {"text": "a", "bbox": [196.9530029296875, 569.3104858398438, 202.54237365722656, 582.877685546875]}, {"text": "×", "bbox": [245.5050048828125, 554.3949584960938, 251.88107299804688, 588.985107421875]}, {"text": "b", "bbox": [196.68299865722656, 585.25048828125, 202.8123321533203, 598.8176879882812]}, {"text": "×", "bbox": [392.3399963378906, 570.3349609375, 398.716064453125, 604.9251098632812]}, {"text": "c", "bbox": [197.3560028076172, 601.1915283203125, 202.1378631591797, 614.7587280273438]}, {"text": "×", "bbox": [343.3949890136719, 586.2760009765625, 349.77105712890625, 620.8661499023438]}, {"text": "d", "bbox": [196.68299865722656, 617.1315307617188, 202.8123321533203, 630.69873046875]}, {"text": "×", "bbox": [294.45001220703125, 602.2160034179688, 300.8260803222656, 636.80615234375]}, {"text": "1 point for each correct tick", "bbox": [114.69100189208984, 644.9844970703125, 242.7321319580078, 658.5516967773438]}, {"text": "-1 point for each incorrect tick", "bbox": [114.69100189208984, 656.9395141601562, 254.66732788085938, 670.5067138671875]}, {"text": "The overall score for this part will not be negative.", "bbox": [114.69100189208984, 668.89453125, 348.03564453125, 682.4617309570312]}, {"text": "4.0 pt", "bbox": [495.45001220703125, 502.80548095703125, 521.8194580078125, 516.3726806640625]}]}, {"page": 11, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-11", "bbox": [377.97100830078125, 59.77293014526367, 538.6260986328125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8270263671875, 128.718505859375, 535.992919921875, 142.28573608398438]}, {"text": "Photosensitisers (PS) offer some advantages over C3N4 for the reduction of CO2. Mn(I)-containing com-", "bbox": [56.69300079345703, 155.21949768066406, 538.5735473632812, 171.27772521972656]}, {"text": "plexes combined with PS can achieve ~23% quantum yield. In this system, reductive quenching of the", "bbox": [56.692962646484375, 167.17449951171875, 538.5736083984375, 180.74172973632812]}, {"text": "singlet (S1) and triplet (T1) excited states of a PS by reductant (Red) forms PS•−, which donates electrons", "bbox": [56.692962646484375, 154.31114196777344, 538.58544921875, 220.2635498046875]}, {"text": "to CO2 through the Mn(I)-containing complex.", "bbox": [56.692962646484375, 191.0854949951172, 272.339599609375, 207.1437225341797]}, {"text": "PS(S1) + Red", "bbox": [56.69296646118164, 191.97213745117188, 113.50304412841797, 257.924560546875]}, {"text": "𝑘𝑆", "bbox": [119.00996398925781, 196.15220642089844, 129.050537109375, 228.62290954589844]}, {"text": "−", "bbox": [116.26996612548828, 201.87496948242188, 123.09434509277344, 236.46511840820312]}, {"text": "−", "bbox": [118.39199829101562, 201.87496948242188, 125.21637725830078, 236.46511840820312]}, {"text": "−", "bbox": [123.00468444824219, 201.87496948242188, 129.82907104492188, 236.46511840820312]}, {"text": "→PS•−+ Red•+", "bbox": [125.11676025390625, 191.97213745117188, 200.14137268066406, 257.924560546875]}, {"text": "𝑘𝑆= 2.7 × 109 M−1 s−1", "bbox": [209.14295959472656, 200.4462127685547, 316.1141357421875, 238.05355834960938]}, {"text": "PS(T1) + Red", "bbox": [56.69293212890625, 223.05712890625, 114.99100494384766, 289.0095520019531]}, {"text": "𝑘𝑇", "bbox": [120.49893188476562, 227.3162078857422, 129.74249267578125, 259.7868957519531]}, {"text": "−", "bbox": [117.7589340209961, 232.9599609375, 124.58331298828125, 267.55010986328125]}, {"text": "−", "bbox": [119.84111785888672, 232.9599609375, 126.66549682617188, 267.55010986328125]}, {"text": "−", "bbox": [124.45380401611328, 232.9599609375, 131.27818298339844, 267.55010986328125]}, {"text": "→PS•−+ Red•+", "bbox": [126.52603149414062, 223.05712890625, 201.5503387451172, 289.0095520019531]}, {"text": "𝑘𝑇= 1.5 × 108 M−1 s−1", "bbox": [210.55194091796875, 231.53021240234375, 317.43310546875, 269.1385498046875]}, {"text": "The following Jablonski diagram describes the processes occurring in the PS:", "bbox": [56.69291687011719, 270.4215087890625, 413.7630920410156, 283.9887390136719]}, {"text": "𝜏0(S1) = 2.9 ns and", "bbox": [56.69300079345703, 533.198974609375, 145.6915283203125, 569.3775634765625]}, {"text": "𝜏0(T1) = 84 𝜇s, where 𝜏0 is the emission lifetime in the absence of the quencher.", "bbox": [153.95999145507812, 533.198974609375, 527.3516845703125, 569.3775634765625]}]}, {"page": 12, "width": 595.280029296875, "height": 841.8900146484375, "mode": "native", "lines": [{"text": "Theory", "bbox": [56.69300079345703, 63.1240119934082, 105.85767364501953, 82.42530822753906]}, {"text": "Q8-12", "bbox": [377.97100830078125, 59.77293014526367, 538.6260986328125, 136.97825622558594]}, {"text": "English (Official)", "bbox": [460.8270263671875, 128.718505859375, 535.992919921875, 142.28573608398438]}, {"text": "8.9", "bbox": [78.60800170898438, 166.2294921875, 92.84233856201172, 179.79672241210938]}, {"text": "Calculate the percentage of quenching, 𝜂𝑞, (in %) of S1 and T1 states, when", "bbox": [114.69253540039062, 151.31396484375, 480.58050537109375, 187.4925537109375]}, {"text": "[Red] = 0.1 M. Note: here the values of 𝑘𝐼𝑆𝐶and 𝑘𝑅𝐼𝑆𝐶are negligible.", "bbox": [114.69097900390625, 163.26898193359375, 443.519775390625, 199.44757080078125]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 190.1405029296875, 169.74588012695312, 203.70773315429688]}, {"text": "The decay process of the S1 excited state can be represented by the following", "bbox": [114.69100189208984, 202.0955047607422, 480.5797119140625, 215.66273498535156]}, {"text": "equation:", "bbox": [114.69100189208984, 214.05050659179688, 159.20455932617188, 227.61773681640625]}, {"text": "−𝑑[𝑆1]", "bbox": [114.69100189208984, 211.07022094726562, 144.30181884765625, 248.75711059570312]}, {"text": "𝑑𝑡", "bbox": [129.44900512695312, 221.5062255859375, 137.5635986328125, 252.6375732421875]}, {"text": "= (𝑘𝐹+ 𝑘𝐼𝐶+ 𝑘𝐼𝑆𝐶) × [𝑆1] ≈(𝑘𝐹+ 𝑘𝐼𝐶) × [𝑆1]", "bbox": [148.26499938964844, 214.16697692871094, 360.19952392578125, 250.34556579589844]}, {"text": "(eq.8.10.1)", "bbox": [380.1247253417969, 204.26414489746094, 424.1200256347656, 270.216552734375]}, {"text": "According to the formula for the lifetime of the reagent in a 1st order reaction", "bbox": [114.69100952148438, 242.59249877929688, 480.57916259765625, 256.15972900390625]}, {"text": "⇒𝜏0 =", "bbox": [114.69100952148438, 241.90997314453125, 145.66139221191406, 278.9911193847656]}, {"text": "1", "bbox": [164.11599731445312, 239.68319702148438, 168.5991973876953, 270.8145446777344]}, {"text": "𝑘𝐹+𝑘𝐼𝐶", "bbox": [149.62399291992188, 249.24923706054688, 181.9558868408203, 281.7189025878906]}, {"text": "The decay process of the T1 excited state can be represented by the following", "bbox": [114.69100189208984, 272.56451416015625, 480.5797424316406, 286.1317443847656]}, {"text": "equation:", "bbox": [114.69100189208984, 284.5195007324219, 159.20455932617188, 298.08673095703125]}, {"text": "−𝑑[𝑇1]", "bbox": [114.69100189208984, 281.5392150878906, 143.40582275390625, 319.22711181640625]}, {"text": "𝑑𝑡", "bbox": [129.00100708007812, 291.9752197265625, 137.10662841796875, 323.1065673828125]}, {"text": "= (𝑘𝑃+𝑘𝑁+𝑘𝑅𝐼𝑆𝐶)×[𝑇1] ≈(𝑘𝑃+𝑘𝑁)×[𝑇1] ⇒𝜏0 =", "bbox": [147.36900329589844, 284.636962890625, 381.2183532714844, 321.7181396484375]}, {"text": "1", "bbox": [398.0829772949219, 282.41021728515625, 402.566162109375, 313.54156494140625]}, {"text": "𝑘𝑃+𝑘𝑁", "bbox": [385.1809997558594, 291.9752197265625, 414.2535705566406, 324.4459228515625]}, {"text": "(eq.8.10.2)", "bbox": [436.5890197753906, 274.734130859375, 480.58404541015625, 340.6865539550781]}, {"text": "In the presence of the Red, 𝑆1 is reductively quenched by Red, and the fraction", "bbox": [114.69100952148438, 300.27996826171875, 480.58416748046875, 336.4585876464844]}, {"text": "of quenched molecules is as follows:", "bbox": [114.69100952148438, 327.1505126953125, 284.7731628417969, 340.7177429199219]}, {"text": "𝜂𝑞=", "bbox": [114.69100952148438, 327.3789978027344, 133.8293914794922, 363.5575866699219]}, {"text": "𝑘𝑠[𝑆1][𝑅𝑒𝑑]", "bbox": [168.72500610351562, 324.1942443847656, 215.7767333984375, 356.6649475097656]}, {"text": "(𝑘𝐹+𝑘𝐼𝐶)[𝑆1]+𝑘𝑠[𝑆1][𝑅𝑒𝑑] =", "bbox": [137.79299926757812, 327.3789978027344, 257.49639892578125, 367.1889343261719]}, {"text": "𝑘𝑠𝜏0[𝑅𝑒𝑑]", "bbox": [266.77203369140625, 324.17022705078125, 305.9879455566406, 356.64093017578125]}, {"text": "1+𝑘𝑠𝜏0[𝑅𝑒𝑑]", "bbox": [261.46002197265625, 334.7182312011719, 311.3009338378906, 367.1889343261719]}, {"text": "(eq.8.10.3)", "bbox": [332.4219970703125, 317.4761657714844, 376.4170227050781, 383.4285888671875]}, {"text": "𝜂𝑞=", "bbox": [114.69099426269531, 349.26898193359375, 133.82937622070312, 385.44757080078125]}, {"text": "2.7×109×2.9×10−9×0.1", "bbox": [143.10499572753906, 346.0117492675781, 232.04148864746094, 378.173583984375]}, {"text": "1+2.7×109×2.9×10−9×0.1 = 0.44 (𝑜𝑟44%)", "bbox": [137.79299926757812, 349.26898193359375, 306.1834411621094, 390.1421203613281]}, {"text": "In the presence of the Red, 𝑇1 is reductively quenched by it and fraction of", "bbox": [114.69098663330078, 364.5389709472656, 480.5738830566406, 400.7175598144531]}, {"text": "quenched molecules as follows:", "bbox": [114.69097900390625, 391.40948486328125, 262.7956237792969, 404.9767150878906]}, {"text": "𝜂𝑞=", "bbox": [114.69097900390625, 391.6379699707031, 133.82936096191406, 427.8165588378906]}, {"text": "𝑘𝑇[𝑇1][𝑅𝑒𝑑]", "bbox": [166.68597412109375, 388.5412292480469, 214.9936981201172, 421.0119323730469]}, {"text": "(𝑘𝑃+𝑘𝑁)[𝑇1]+𝑘𝑇[𝑇1][𝑅𝑒𝑑] =", "bbox": [137.79299926757812, 391.6379699707031, 254.67539978027344, 431.4479064941406]}, {"text": "𝑘𝑇𝜏0[𝑅𝑒𝑑]", "bbox": [263.9510192871094, 388.42919921875, 305.3099670410156, 420.89990234375]}, {"text": "1+𝑘𝑇𝜏0[𝑅𝑒𝑑]", "bbox": [258.63800048828125, 398.9772033691406, 310.6229553222656, 431.4479064941406]}, {"text": "(eq.8.10.4)", "bbox": [331.7519836425781, 381.7351379394531, 375.74700927734375, 447.68756103515625]}, {"text": "𝜂𝑞=", "bbox": [114.69097900390625, 413.5909729003906, 133.82936096191406, 449.7695617675781]}, {"text": "1.5×108×84×10−6×0.1", "bbox": [143.10498046875, 410.334716796875, 229.8004608154297, 442.4965515136719]}, {"text": "1+1.5×108×84×10−6×0.1 = 0.999 (𝑜𝑟99.9%)", "bbox": [137.79299926757812, 413.5909729003906, 316.3956604003906, 454.52911376953125]}, {"text": "2 points for each correctly derived equations 8.10.1-8.10.4.", "bbox": [114.69098663330078, 443.84051513671875, 388.0554504394531, 457.4077453613281]}, {"text": "2 points for each correct 𝜂𝑞value.", "bbox": [114.69098663330078, 440.8799743652344, 271.0378112792969, 477.0585632324219]}, {"text": "12.0 pt", "bbox": [495.1520080566406, 166.15451049804688, 526.921142578125, 179.72174072265625]}, {"text": "8.10", "bbox": [78.60800170898438, 492.25750732421875, 98.54094696044922, 505.8247375488281]}, {"text": "How do the emission lifetimes of S1 and T1 states change when [Red] increases?", "bbox": [114.69253540039062, 492.25750732421875, 480.5787353515625, 508.31573486328125]}, {"text": "Tick the correct box.", "bbox": [114.69099426269531, 504.2135009765625, 210.88375854492188, 517.7807006835938]}, {"text": "a) increases", "bbox": [137.3679962158203, 516.1685180664062, 189.77256774902344, 529.7357177734375]}, {"text": "b) decreases", "bbox": [137.3679962158203, 528.1234741210938, 192.2831268310547, 541.690673828125]}, {"text": "c) doesn't change", "bbox": [137.3679962158203, 540.0784301757812, 214.25958251953125, 553.6456298828125]}, {"text": "SOLUTION:", "bbox": [114.69100189208984, 552.0335083007812, 169.74588012695312, 565.6007080078125]}, {"text": "After quenching of the PS, the following equation is derived:", "bbox": [114.69100189208984, 563.9884643554688, 395.6270446777344, 577.5556640625]}, {"text": "−𝑑[𝑆1]", "bbox": [114.69100189208984, 561.0091552734375, 144.30181884765625, 598.6961059570312]}, {"text": "𝑑𝑡", "bbox": [129.44900512695312, 571.4442138671875, 137.5635986328125, 602.5755615234375]}, {"text": "= (𝑘𝐹+ 𝑘𝐼𝐶+ 𝑘𝑆× [𝑅𝑒𝑑]) × [𝑆1] ⇒𝜏=", "bbox": [148.26499938964844, 564.1060180664062, 323.3219909667969, 600.2846069335938]}, {"text": "1", "bbox": [364.2220153808594, 561.8792724609375, 368.7052001953125, 593.0105590820312]}, {"text": "𝑘𝐹+𝑘𝐼𝐶+𝑘𝑆×[𝑅𝑒𝑑]", "bbox": [327.28900146484375, 571.4442138671875, 405.638427734375, 603.9149169921875]}, {"text": "As the concentration of [Red] increases, 𝜏decreases accordingly.", "bbox": [114.6910400390625, 579.844970703125, 415.8394470214844, 614.4351196289062]}, {"text": "a", "bbox": [209.31199645996094, 623.6005249023438, 214.9013671875, 637.167724609375]}, {"text": "b", "bbox": [294.572998046875, 623.6005249023438, 300.70233154296875, 637.167724609375]}, {"text": "c", "bbox": [380.77801513671875, 623.6005249023438, 385.55987548828125, 637.167724609375]}, {"text": "×", "bbox": [294.45001220703125, 624.6259765625, 300.8260803222656, 659.2161254882812]}, {"text": "2 points for the only correct ticking", "bbox": [114.69100189208984, 667.39453125, 278.00030517578125, 680.9617309570312]}, {"text": "2.0 pt", "bbox": [495.45001220703125, 492.1824951171875, 521.8194580078125, 505.7497253417969]}]}]